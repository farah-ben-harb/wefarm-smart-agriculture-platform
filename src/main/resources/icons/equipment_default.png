<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 200 200">
  <!-- Background -->
  <rect width="200" height="200" fill="#f5f5f5" rx="10" ry="10"/>
  
  <!-- Tractor icon -->
  <g transform="translate(40, 50)" fill="#1cc88a">
    <!-- Tractor body -->
    <rect x="20" y="30" width="80" height="40" rx="5" ry="5"/>
    
    <!-- Tractor cabin -->
    <rect x="80" y="10" width="30" height="30" rx="3" ry="3"/>
    
    <!-- Wheels -->
    <circle cx="30" cy="80" r="20"/>
    <circle cx="90" cy="80" r="25"/>
    
    <!-- Details -->
    <rect x="10" y="40" width="20" height="5"/>
    <rect x="85" y="0" width="20" height="10"/>
  </g>
  
  <!-- Text -->
  <text x="100" y="150" font-family="Arial" font-size="16" text-anchor="middle" fill="#555555">Équipement</text>
</svg>