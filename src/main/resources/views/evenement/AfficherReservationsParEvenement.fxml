<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefWidth="800" prefHeight="600"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Event.AfficherReservationsParEvenementController">

    <VBox spacing="10" AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0">
        <!-- Bouton d'export PDF -->
        <Button fx:id="exportPdfBtn"
                text="Exporter PDF"
                onAction="#handleExportPdf"
                style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-padding: 10 15; -fx-font-weight: bold;"
                alignment="CENTER_RIGHT" />

        <!-- Conteneur scrollable pour les cartes de réservation -->
        <ScrollPane fitToWidth="true" fitToHeight="true" maxHeight="Infinity">
            <TilePane fx:id="reservationTilePane"
                      hgap="20"
                      vgap="20"
                      prefColumns="2"
                      style="-fx-padding: 20;" />
        </ScrollPane>
    </VBox>

</AnchorPane>
