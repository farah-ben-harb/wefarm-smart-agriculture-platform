<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@/css/StyleEvents.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Event.AfficherEvenementsClientController">

    <!-- Navbar positionnée en haut et prenant toute la largeur -->
    <fx:include fx:id="navbar" source="../navbarFront.fxml" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="0" />

    <!-- Conteneur principal vertical -->
    <VBox spacing="10" AnchorPane.leftAnchor="180" AnchorPane.rightAnchor="40" AnchorPane.topAnchor="100">
        <!-- Première ligne : Titre et bouton Ajouter -->
        <HBox alignment="CENTER_LEFT" spacing="20" AnchorPane.topAnchor="50">
            <!-- Titre -->
            <Label styleClass="main-title" text="Les Événements" />

            <!-- Élément flexible pour pousser le bouton à droite -->
            <Region HBox.hgrow="ALWAYS" />
            <!-- Bouton Ajouter complètement à droite -->
            <Button fx:id="voirReservationBtn" onAction="#handleVoirMesReservations"
                    style="
            -fx-font-size: 14px;
            -fx-font-weight: bold;
            -fx-text-fill: white;
            -fx-background-color: #28a745;
            -fx-background-radius: 6px;
            -fx-padding: 10 20;
            -fx-cursor: hand;
            -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 0, 2, 0, 0);
        "
                    text="Voir mes réservations" />


        </HBox>

        <!-- Deuxième ligne : Barre de recherche avec loupe -->
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="search-container">
            <ImageView fitHeight="20" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@/icons/search-icon.png" />
            </ImageView>
            <TextField fx:id="searchField" prefHeight="26.0" prefWidth="360.0" promptText="Rechercher un événement par titre..." styleClass="search-field" />
        </HBox>
    </VBox>

    <!-- Contenu principal avec défilement -->
    <ScrollPane fx:id="mainScroll" styleClass="main-scroll" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="200.0">
        <TilePane fx:id="evenementTilePane" alignment="TOP_LEFT" hgap="30" prefColumns="3" prefTileHeight="280" prefTileWidth="380" styleClass="tile-pane" vgap="30">
            <padding>
                <Insets bottom="30" left="30" right="30" top="20" />
            </padding>

            <!-- Exemple de carte d'événement (sera générée dynamiquement) -->
            <VBox prefHeight="207.0" prefWidth="313.0" styleClass="event-card">
                <VBox spacing="5" styleClass="card-header">
                    <Label styleClass="card-title" text="Titre Événement" />
                    <Label styleClass="card-subtitle" text="🔍 Sur place" />
                </VBox>
                <VBox spacing="5" styleClass="card-content">
                    <Label styleClass="card-date" text="📅 15/06/2024 14:00" />
                    <Label styleClass="card-text" text="🌍 Localisation" />
                    <Label styleClass="card-text" text="💵 50.0 DT" />
                </VBox>
                <HBox spacing="10" styleClass="card-actions">
                    <Button styleClass="card-button" text="Détails" />
                    <Button styleClass="card-button-delete" text="Supprimer" />
                </HBox>
            </VBox>
        </TilePane>
    </ScrollPane>
</AnchorPane>
