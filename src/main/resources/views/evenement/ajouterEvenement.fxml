<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<?import java.lang.String?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.Event.AjouterEvenementController"
            stylesheets="@/css/stylesOffresEmploi.css"
            prefHeight="600.0" prefWidth="800.0">

    <!-- Navbar -->
    <fx:include fx:id="navbar" source="../navbarFront.fxml" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20"/>

    <!-- Main container -->
    <VBox spacing="20" alignment="CENTER"
          AnchorPane.topAnchor="30" AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <!-- Title -->
        <Label text="Ajouter un Événement" styleClass="form-title"/>

        <!-- Form -->
        <GridPane hgap="15" vgap="5" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints prefWidth="150" halignment="RIGHT"/>
                <ColumnConstraints prefWidth="300" halignment="LEFT"/>
                <ColumnConstraints prefWidth="150" halignment="RIGHT"/>
                <ColumnConstraints prefWidth="300" halignment="LEFT"/>
            </columnConstraints>

            <!-- Left column -->
            <!-- Title -->
            <Label text="📝 Titre" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="titreField" styleClass="form-field" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Text fx:id="titreError" fill="RED" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <!-- Description -->
            <Label text="≡ Description" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextArea fx:id="descriptionField" styleClass="form-field" GridPane.rowIndex="2" GridPane.columnIndex="1" prefHeight="100"/>
            <Text fx:id="descriptionError" fill="RED" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <!-- Right column -->
            <!-- Start date -->
            <Label text="📅 Date de début" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <DatePicker fx:id="dateDebutPicker" styleClass="form-field" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
            <Text fx:id="dateDebutError" fill="RED" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

            <!-- Visit type -->
            <Label text="🔍 Type de visite" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
            <ComboBox fx:id="typeVisiteComboBox" styleClass="form-field" GridPane.rowIndex="2" GridPane.columnIndex="3">
            </ComboBox>
            <Text fx:id="typeVisiteError" fill="RED" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

            <!-- Location -->
            <Label text="🌍 Localisation" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="localisationField" styleClass="form-field" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Text fx:id="localisationError" fill="RED" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <!-- Price -->
            <Label text="💵 Prix" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
            <TextField fx:id="prixField" styleClass="form-field" GridPane.rowIndex="4" GridPane.columnIndex="3"/>
            <Text fx:id="prixError" fill="RED" GridPane.rowIndex="5" GridPane.columnIndex="3"/>

        </GridPane>

        <!-- Buttons -->
        <HBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
            <Button text="Annuler" styleClass="cancel-button" onAction="#annulerAjout" />
            <Button text="Enregistrer" styleClass="add-button" onAction="#handleSave"/>
        </HBox>
    </VBox>
</AnchorPane>