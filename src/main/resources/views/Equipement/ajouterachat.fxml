<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" styleClass="form-container" stylesheets="@/style_css/modern_forms.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Equipement.AddAchatController">
   <children>
      <VBox layoutX="50.0" layoutY="30.0" prefHeight="440.0" prefWidth="500.0" spacing="15.0">
         <children>
            <Label text="Ajouter/Modifier un Achat" textAlignment="CENTER" styleClass="form-title">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            
            <VBox spacing="5.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label prefWidth="150.0" text="Équipement:" styleClass="form-label">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="equipementComboBox" prefHeight="30.0" prefWidth="300.0" promptText="Sélectionner un équipement" styleClass="combo-box" />
                     </children>
                  </HBox>
                  <Label fx:id="equipementErrorLabel" styleClass="form-error" visible="false" managed="false" text="Veuillez sélectionner un équipement" />
               </children>
            </VBox>
            
            <VBox spacing="5.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label prefWidth="150.0" text="Date d'achat:" styleClass="form-label">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <DatePicker fx:id="datePicker" prefHeight="30.0" prefWidth="300.0" promptText="Sélectionner une date" styleClass="date-picker" />
                     </children>
                  </HBox>
                  <Label fx:id="dateErrorLabel" styleClass="form-error" visible="false" managed="false" text="Veuillez sélectionner une date valide" />
               </children>
            </VBox>
            
            <VBox spacing="5.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label prefWidth="150.0" text="Montant total (€):" styleClass="form-label">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="totalField" prefHeight="30.0" prefWidth="300.0" promptText="Entrer le montant total" styleClass="form-field" />
                     </children>
                  </HBox>
                  <Label fx:id="totalErrorLabel" styleClass="form-error" visible="false" managed="false" text="Le montant doit être un nombre positif" />
               </children>
            </VBox>
            
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave" prefHeight="40.0" prefWidth="120.0" styleClass="form-button" text="Enregistrer" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" prefHeight="40.0" prefWidth="120.0" styleClass="form-button, cancel" text="Annuler" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
