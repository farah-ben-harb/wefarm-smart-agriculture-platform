<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" styleClass="screen" stylesheets="@../style_css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Equipement.AIRecommendationController">
   <top>
      <VBox>
         <!-- Include the navbar -->
         <fx:include source="../navbarFront.fxml" />
         
         <HBox alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="900.0" style="-fx-background-color: #1cc88a;" BorderPane.alignment="CENTER">
            <children>
               <Label text="SYSTÈME DE RECOMMANDATION IA" textFill="WHITE">
                  <font>
                     <Font name="System Bold" size="24.0" />
                  </font>
                  <HBox.margin>
                     <Insets left="20.0" />
                  </HBox.margin>
               </Label>
            </children>
         </HBox>
      </VBox>
   </top>
   <center>
      <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Décrivez votre équipement ou votre besoin pour obtenir des recommandations d'optimisation des ventes">
               <font>
                  <Font size="14.0" />
               </font>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Label>
            <TextArea fx:id="queryField" prefHeight="100.0" prefWidth="600.0" promptText="Ex: Je veux vendre 10 tracteurs à 15000 DT chacun..." wrapText="true">
               <VBox.margin>
                  <Insets left="50.0" right="50.0" />
               </VBox.margin>
            </TextArea>
            <Button fx:id="generateButton" mnemonicParsing="false" onAction="#handleGenerateRecommendation" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: #1cc88a; -fx-text-fill: white;" text="Générer des recommandations">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Label fx:id="loadingLabel" text="Génération en cours..." visible="false">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <ScrollPane fitToWidth="true" prefHeight="300.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
               <content>
                  <TextArea fx:id="recommendationResult" editable="false" prefHeight="300.0" prefWidth="880.0" wrapText="true" />
               </content>
               <VBox.margin>
                  <Insets left="20.0" right="20.0" />
               </VBox.margin>
            </ScrollPane>
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" prefHeight="40.0" prefWidth="150.0" text="Retour" />
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" top="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>