<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>

<BorderPane prefHeight="650.0" prefWidth="900.0" styleClass="screen" stylesheets="@/style_css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Equipement.achatcontroller">
   <left>
      <fx:include source="../navbarBack.fxml" />
   </left>
   <center>
      <AnchorPane prefHeight="650.0" prefWidth="900.0">
         <children>
            <Pane layoutY="44.0" prefHeight="600.0" prefWidth="900.0">
               <children>
                  <TableView fx:id="achattable" layoutX="14.0" layoutY="140.0" prefHeight="264.0" prefWidth="855.0">
                     <columns>
                        <TableColumn fx:id="id_achat" prefWidth="49.60003662109375" text="ID" />
                        <TableColumn fx:id="equipement_id" prefWidth="120.0" text="Équipement" />
                        <TableColumn fx:id="date" prefWidth="120.0" text="Date" />
                        <TableColumn fx:id="total" prefWidth="100.0" text="Total" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <Button fx:id="ajouter" layoutX="783.0" layoutY="75.0" mnemonicParsing="false" onAction="#ajouterachat" style="-fx-background-color: #339933;" text="Ajouter" />
                  <Button fx:id="exporter" layoutX="687.0" layoutY="75.0" mnemonicParsing="false" onAction="#exportertable" prefHeight="35.0" prefWidth="88.0" style="-fx-background-color: #9fdf9f;" text="Print" />
                  <Button fx:id="retour" layoutX="14.0" layoutY="75.0" mnemonicParsing="false" onAction="#retourEquipement" style="-fx-background-color: #339933;" text="Retour" />
               </children>
            </Pane>
         </children>
      </AnchorPane>
   </center>
</BorderPane>
