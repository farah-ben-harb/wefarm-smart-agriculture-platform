<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>

<BorderPane prefHeight="650.0" prefWidth="900.0" styleClass="screen" stylesheets="@/style_css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Equipement.equipementcontroller">
   <left>
      <fx:include source="../navbarBack.fxml" />
   </left>
   <center>
      <AnchorPane prefHeight="650.0" prefWidth="900.0">
         <children>
            <Pane layoutY="44.0" prefHeight="600.0" prefWidth="900.0">
               <children>
                  <TableView fx:id="equipementtable" layoutX="14.0" layoutY="141.0" prefHeight="263.0" prefWidth="854.0">
                     <columns>
                        <TableColumn fx:id="id_equipement" prefWidth="49.60003662109375" text="ID" />
                        <TableColumn fx:id="nom_equipement" prefWidth="120.0" text="Nom" />
                        <TableColumn fx:id="quantite_disponible" prefWidth="120.0" text="Quantité" />
                        <TableColumn fx:id="prix" prefWidth="100.0" text="Prix" />
                        <TableColumn fx:id="image" prefWidth="120.0" text="Image" />
                        <TableColumn fx:id="category" prefWidth="342.79998779296875" text="Catégorie" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <Button fx:id="ajouter" layoutX="783.0" layoutY="75.0" mnemonicParsing="false" onAction="#ajouterequipement" style="-fx-background-color: #9fdf9f;" text="Ajouter" />
                  <Button fx:id="exporter" layoutX="687.0" layoutY="75.0" mnemonicParsing="false" onAction="#exportertable" prefHeight="35.0" prefWidth="71.0" style="-fx-background-color: #339933;" text="Print" />
                  <Button fx:id="achatBtn" layoutX="580.0" layoutY="75.0" mnemonicParsing="false" onAction="#navigateToAchat" prefHeight="25.0" prefWidth="90.0" style="-fx-background-color: #9fdf9f;" text="Achats" />
               </children>
            </Pane>
         </children>
      </AnchorPane>
   </center>
</BorderPane>
