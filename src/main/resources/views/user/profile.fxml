<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.User.ProfileController"
            style="-fx-background-color: #f5f5f5;"
            prefHeight="700" prefWidth="1000">
    <!-- Navbar positionnée en haut et prenant toute la largeur -->
    <fx:include fx:id="navbar" source="../navbarFront.fxml" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20"/>
    <!-- Conteneur principal centré -->
    <VBox alignment="CENTER" spacing="20" AnchorPane.topAnchor="120" AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <!-- Carte de profil avec ombre et effet de profondeur -->
        <BorderPane style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);"
                    prefWidth="900" prefHeight="400">

            <!-- Section gauche - Photo de profil -->
            <left>
                <VBox alignment="TOP_CENTER" spacing="10" style="-fx-padding: 20px;">
                    <StackPane>
                        <ImageView fx:id="profileImage" fitHeight="148" fitWidth="148"
                                   preserveRatio="false"/>
                    </StackPane>

                    <VBox alignment="CENTER" spacing="5" style="-fx-padding: 10px 0;">
                        <Label fx:id="fullNameLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <HBox alignment="CENTER" spacing="5">
                            <Circle fx:id="statusCircle" radius="5"/>
                            <Label fx:id="statusLabel" style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </left>

            <!-- Section centrale - Informations avec scroll -->
            <center>

                <VBox style="-fx-padding: 30 30 30 20;" spacing="20">
                    <!-- En-tête avec animation au survol -->
                    <VBox spacing="8"  >
                        <Label text="INFORMATIONS DU PROFIL"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                        <Separator style="-fx-background-color: #e0e0e0; -fx-padding: 0 0 2 0;"/>
                    </VBox>

                    <!-- Grille d'informations responsive -->
                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="150" prefWidth="150"/>
                            <ColumnConstraints halignment="LEFT" minWidth="250" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <!-- Lignes d'information avec effets de survol -->
                        <Label text="Email:" style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-font-size: 14px;"/>
                        <Label fx:id="emailLabel" style="-fx-text-fill: #444; -fx-font-size: 14px;"
                               GridPane.columnIndex="1" wrapText="true"/>

                        <Label text="Adresse:" style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-font-size: 14px;" GridPane.rowIndex="1"/>
                        <Label fx:id="adresseLabel" style="-fx-text-fill: #444; -fx-font-size: 14px;"
                               GridPane.rowIndex="1" GridPane.columnIndex="1" wrapText="true"/>

                        <Label text="Téléphone:" style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-font-size: 14px;" GridPane.rowIndex="2"/>
                        <Label fx:id="numTelLabel" style="-fx-text-fill: #444; -fx-font-size: 14px;"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Membre depuis:" style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-font-size: 14px;" GridPane.rowIndex="3"/>
                        <Label fx:id="joinDateLabel" style="-fx-text-fill: #444; -fx-font-size: 14px;"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Date de naissance:" style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-font-size: 14px;" GridPane.rowIndex="4"/>
                        <Label fx:id="dateNaissanceLabel" style="-fx-text-fill: #444; -fx-font-size: 14px;"
                               GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Rôles:" style="-fx-font-weight: bold; -fx-text-fill: #555; -fx-font-size: 14px;" GridPane.rowIndex="5"/>
                        <Label fx:id="rolesLabel" style="-fx-text-fill: #444; -fx-font-size: 14px;"
                               GridPane.rowIndex="5" GridPane.columnIndex="1" wrapText="true"/>
                    </GridPane>

                    <!-- Boutons d'action avec animations -->
                    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
                        <Button fx:id="modifierButton" text="📝 Modifier"
                                style="-fx-background-color: white; -fx-border-color: #f39c12; -fx-text-fill: #f39c12; -fx-font-weight: bold;
                                          -fx-padding: 10 25; -fx-font-size: 14px; -fx-border-radius: 20; -fx-background-radius: 20;
                                          -fx-cursor: hand;"
                                onMouseEntered="#handleButtonHover" onMouseExited="#handleButtonLeave"/>

                        <Button fx:id="destinataireButton" text="🚫 Désactiver"
                                style="-fx-background-color: white; -fx-border-color: #f39c12; -fx-text-fill: #f39c12; -fx-font-weight: bold;
                                          -fx-padding: 10 25; -fx-font-size: 14px; -fx-border-radius: 20; -fx-background-radius: 20;
                                          -fx-cursor: hand;"
                                onMouseEntered="#handleButtonHover" onMouseExited="#handleButtonLeave"/>

                        <Button fx:id="supprimerButton" text="❌ Supprimer"
                                style="-fx-background-color: white; -fx-border-color: #f39c12; -fx-text-fill: #f39c12; -fx-font-weight: bold;
                                          -fx-padding: 10 25; -fx-font-size: 14px; -fx-border-radius: 20; -fx-background-radius: 20;
                                          -fx-cursor: hand;"
                                onMouseEntered="#handleButtonHover" onMouseExited="#handleButtonLeave"/>
                    </HBox>
                </VBox>

            </center>
        </BorderPane>

        <!-- Cartes de fonctionnalités avec animations -->
        <GridPane hgap="20" vgap="20" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
            </columnConstraints>


            <!-- Cartes principales avec effets de survol -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 0);"
                  GridPane.rowIndex="0" GridPane.columnIndex="0"
                  onMouseEntered="#handleCardHover" onMouseExited="#handleCardLeave">
                <ImageView fitWidth="50" fitHeight="50" preserveRatio="true">
                    <image>
                        <Image url="@../../img/seedling.png"/>
                    </image>
                </ImageView>
                <Label text="Suivi des cultures" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #333; -fx-padding: 10 0 5 0;"/>
                <Label text="Suivez la croissance de vos cultures avec des outils d'analyse avancés"
                       style="-fx-font-size: 13px; -fx-text-fill: #666;" wrapText="true"/>
            </VBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 0);"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"

                  onMouseEntered="#handleCardHover" onMouseExited="#handleCardLeave">
                <ImageView fitWidth="50" fitHeight="50" preserveRatio="true">
                    <image>
                        <Image url="@../../img/water-drop.png"/>
                    </image>
                </ImageView>
                <Label text="Gestion des ressources" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #333; -fx-padding: 10 0 5 0;"/>
                <Label text="Optimisez l'utilisation de l'eau et des ressources naturelles"
                       style="-fx-font-size: 13px; -fx-text-fill: #666;" wrapText="true"/>
            </VBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 0);"
                  GridPane.rowIndex="0" GridPane.columnIndex="2"
                  onMouseEntered="#handleCardHover" onMouseExited="#handleCardLeave">
                <ImageView fitWidth="50" fitHeight="50" preserveRatio="true">
                    <image>
                        <Image url="@../../img/cloud-sun.png"/>
                    </image>
                </ImageView>
                <Label text="Prévisions météo" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #333; -fx-padding: 10 0 5 0;"/>
                <Label text="Recevez des alertes météo précises pour planifier vos activités"
                       style="-fx-font-size: 13px; -fx-text-fill: #666;" wrapText="true"/>
            </VBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 0);"
                  GridPane.rowIndex="0" GridPane.columnIndex="3"
                  onMouseEntered="#handleCardHover" onMouseExited="#handleCardLeave">
                <ImageView fitWidth="50" fitHeight="50" preserveRatio="true">
                    <image>
                        <Image url="@../../img/leaf.png"/>
                    </image>
                </ImageView>
                <Label text="Marché des produits" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #333; -fx-padding: 10 0 5 0;"/>
                <Label text="Vendez vos produits directement aux consommateurs"
                       style="-fx-font-size: 13px; -fx-text-fill: #666;" wrapText="true"/>
            </VBox>

            <!-- Section fonctionnalités supplémentaires -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 25;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 0);"
                  GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="4"
                  onMouseEntered="#handleCardHover" onMouseExited="#handleCardLeave">
                <Label text="FONCTIONNALITÉS SUPPLÉMENTAIRES"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;"/>

                <VBox spacing="12" style="-fx-padding: 15 0 0 0;">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <ImageView fitWidth="25" fitHeight="25" preserveRatio="true">
                            <image>
                                <Image url="@../../img/share.png"/>
                            </image>
                        </ImageView>
                        <Label text="Partage de bonnes pratiques entre agriculteurs"
                               style="-fx-font-size: 14px; -fx-text-fill: #444;"/>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <ImageView fitWidth="25" fitHeight="25" preserveRatio="true">
                            <image>
                                <Image url="@../../img/chart.png"/>
                            </image>
                        </ImageView>
                        <Label text="Suivi détaillé des performances agricoles"
                               style="-fx-font-size: 14px; -fx-text-fill: #444;"/>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <ImageView fitWidth="25" fitHeight="25" preserveRatio="true">
                            <image>
                                <Image url="@../../img/tools.png"/>
                            </image>
                        </ImageView>
                        <Label text="Outils d'agriculture de précision"
                               style="-fx-font-size: 14px; -fx-text-fill: #444;"/>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <ImageView fitWidth="25" fitHeight="25" preserveRatio="true">
                            <image>
                                <Image url="@../../img/book.png"/>
                            </image>
                        </ImageView>
                        <Label text="Modules d'éducation et formations en ligne"
                               style="-fx-font-size: 14px; -fx-text-fill: #444;"/>
                    </HBox>
                </VBox>
            </VBox>
        </GridPane>
    </VBox>
</AnchorPane>