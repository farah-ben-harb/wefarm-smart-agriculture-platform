<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.shape.Circle?>

<BorderPane style="-fx-background-color: #f8f9fa;"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.User.AdminController" stylesheets="/css/styleAdmin.css">

<left>
    <fx:include  source="../navbarBack.fxml" />

</left>
    <!-- Contenu principal -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20;" >
            <!-- En-tête -->
            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0 20 0;">

                 <!--barre sup-->
                <!-- Barre supérieure -->
                <HBox fx:id="searchBarHBox" spacing="0" alignment="CENTER" style="-fx-background-color: #ffffff; -fx-padding: 0 0; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;">
                    <!-- Groupe recherche + bouton aligné à gauche -->
                    <HBox spacing="5" alignment="CENTER">
                        <!-- Champ de recherche avec style transparent -->
                        <TextField  promptText="Rechercher..."
                                    style="
                         -fx-pref-width: 400px;
                         -fx-background-radius: 20;
                         -fx-border-radius: 20;
                         -fx-padding: 8 15;
                         -fx-background-color: rgba(0,0,0,0.05);
                         -fx-prompt-text-fill: #a0a0a0;
                     "/>

                        <!-- Bouton recherche vert -->
                        <Button text="🔍"
                                style="
                       -fx-background-radius: 20;
                       -fx-padding: 8 15;
                       -fx-min-width: 40px;
                       -fx-background-color: #1cc88a;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                   "/>
                    </HBox>

                    <!-- Espace étirable pour repousser les autres éléments à droite -->
                    <Region HBox.hgrow="ALWAYS" />

                    <!-- Bouton notification style discret -->
                    <Button  text="🔔"
                             style="
                           -fx-padding: 15 20;
                            -fx-min-width: 60px;
                            -fx-min-height: 60px;
                            -fx-background-color: transparent;
                            -fx-text-fill: #d1d3e2;
                            -fx-font-size: 18px;
                            -fx-cursor: hand;
                       "/>

                    <!-- Bouton message style discret -->
                    <Button text="📩"
                            style="
                            -fx-padding: 15 20;
                            -fx-min-width: 60px;
                            -fx-min-height: 60px;
                            -fx-background-color: transparent;
                            -fx-text-fill: #d1d3e2;
                            -fx-font-size: 24px;
                            -fx-cursor: hand;
                        "/>

                    <!-- Séparateur avant le menu admin -->
                    <Separator orientation="VERTICAL" style="-fx-padding: 0 10px;" />

                    <!-- Menu admin avec texte gris -->
                    <MenuButton style="-fx-background-color: transparent;" HBox.hgrow="NEVER">
                        <graphic>
                            <HBox spacing="5" alignment="CENTER">
                                <Label text="Admin" style="-fx-text-fill: #858796; -fx-font-size: 14px;" />
                                <ImageView fitHeight="28" fitWidth="28">
                                    <Image url="@/img/admin.png"/>
                                </ImageView>
                            </HBox>
                        </graphic>
                        <items>
                            <MenuItem text="Profil" />
                            <MenuItem text="Paramètres" />
                            <MenuItem text="Activité" />
                            <SeparatorMenuItem />
                            <MenuItem text="Déconnexion" />
                        </items>
                    </MenuButton>
                </HBox>

                <!-- Titre Centré -->
                    <Label text="GESTION UTILISATEURS"
                           style="-fx-text-fill: #858796; -fx-font-weight: bold; -fx-font-size: 24;"/>

                    <!-- Bouton Ajouter utilisateur -->
                    <Button fx:id="addButton" onAction="#handleAddButton"
                            style="-fx-background-color: #1cc88a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;">
                        <graphic>
                            <HBox alignment="CENTER" spacing="5">
                                <ImageView fitHeight="16" fitWidth="16">
                                    <Image url="@../../img/user-plus.png"/>
                                </ImageView>
                                <Label text="Ajouter un utilisateur" style="-fx-text-fill: white; -fx-font-size: 14;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </VBox>

            <!-- Conteneur pour barre de recherche et boutons -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <!-- Barre de recherche élargie -->
                <HBox style="-fx-background-color: white; -fx-border-color: #ced4da; -fx-border-radius: 4; -fx-padding: 5;"
                      alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="@../../img/search-icon.png"/>
                    </ImageView>
                    <TextField fx:id="rechercheField"
                               promptText="Rechercher par nom, prénom ou email"
                               style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 0 5;"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Boutons à droite -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <!-- Bouton Statistiques -->
                    <Button fx:id="statsButton" onAction="#handleStatsButton"
                            style="-fx-background-color: #1cc88a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;">
                        <graphic>
                            <HBox alignment="CENTER" spacing="5">
                                <ImageView fitHeight="16" fitWidth="16">
                                    <Image url="@../../img/chart-bar.png"/>
                                </ImageView>
                                <Label text="Statistiques" style="-fx-text-fill: white; -fx-font-size: 14;"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <!-- Bouton Activités -->
                    <Button onMouseClicked="#redirectToActivities"
                            style="-fx-background-color: #cbd164; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;">
                        <graphic>
                            <HBox alignment="CENTER" spacing="5">
                                <ImageView fitHeight="16" fitWidth="16">
                                    <Image url="@../../img/activities_icon.png"/>
                                </ImageView>
                                <Label text="Activités" style="-fx-text-fill: white; -fx-font-size: 14;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>

            <!-- Conteneur blanc pour la TableView avec ombre portée -->
                <!-- TableView avec scroll intégré -->
        <VBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">

        <TableView fx:id="tableViewUsers"
                       style="-fx-background-color: white;
                  -fx-border-color: #dee2e6;
                  -fx-border-radius: 5;
                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);
                  -fx-table-cell-border-color: transparent;"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" style="-fx-alignment: CENTER;" prefWidth="50" />
                    <TableColumn fx:id="colImage" text="Photo" style="-fx-alignment: CENTER;" prefWidth="80"/>
                    <TableColumn fx:id="colFirstName" text="Prénom" prefWidth="120" />
                    <TableColumn fx:id="colLastName" text="Nom" prefWidth="120" />
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="200" />
                    <TableColumn fx:id="colDateCreation" text="Date de création" prefWidth="200" />
                    <TableColumn fx:id="colDateNaissance" text="Date de naissance" prefWidth="200" />
                    <TableColumn fx:id="colAdresse" text="Adresse" prefWidth="200" />
                    <TableColumn fx:id="colRoles" text="Rôle" prefWidth="150" />
                    <TableColumn fx:id="colPassword" text="Rôle" prefWidth="150" />
                    <TableColumn fx:id="colNumTel" text="Téléphone" prefWidth="150" />
                    <TableColumn fx:id="colStatus" text="Statut" style="-fx-alignment: CENTER;" prefWidth="100">
                        <cellValueFactory>
                            <PropertyValueFactory property="status" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colAction" text="Actions" style="-fx-alignment: CENTER;" prefWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>

                    </TableView>
        </VBox>

        </VBox>
    </center>
</BorderPane>