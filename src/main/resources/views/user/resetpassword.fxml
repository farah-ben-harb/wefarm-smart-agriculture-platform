<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.Rectangle?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.User.ResetPasswordController"
           style="-fx-background-color: #d8f3e2; -fx-padding: 20px;">

    <!-- Conteneur principal à taille fixe -->
    <VBox alignment="CENTER" spacing="20"
          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);"
          maxWidth="600" prefWidth="600"
          maxHeight="700" prefHeight="700">

        <!-- Logo ou icône -->
        <ImageView fitHeight="170" fitWidth="170" preserveRatio="true">
            <image>
                <Image url="@/img/logo1.png" />
            </image>
        </ImageView>

        <!-- Titre -->
        <Label text="Réinitialisation du mot de passe" style="-fx-text-fill: #2c3e50;">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <!-- Champ Nouveau mot de passe -->
        <VBox spacing="5" alignment="CENTER_LEFT" maxWidth="400">
            <Label text="Nouveau mot de passe" style="-fx-text-fill: #2c3e50;"/>
            <PasswordField fx:id="newPasswordField"
                           style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 10px;"
                           maxWidth="400" prefWidth="400">
                <font>
                    <Font size="14.0" />
                </font>
            </PasswordField>
            <!-- Barre de force du mot de passe -->
            <HBox alignment="CENTER_LEFT" spacing="5">
                <Label text="Force:" style="-fx-text-fill: #7f8c8d;"/>
                <HBox spacing="2" alignment="CENTER_LEFT">
                    <Rectangle fx:id="strengthBar1" width="50" height="5" fill="#e0e0e0" arcWidth="5" arcHeight="5"/>
                    <Rectangle fx:id="strengthBar2" width="50" height="5" fill="#e0e0e0" arcWidth="5" arcHeight="5"/>
                    <Rectangle fx:id="strengthBar3" width="50" height="5" fill="#e0e0e0" arcWidth="5" arcHeight="5"/>
                </HBox>
                <Label fx:id="strengthLabel" text="" style="-fx-text-fill: #7f8c8d; -fx-padding: 0 0 0 5;"/>
            </HBox>
            <!-- Message d'erreur pour le mot de passe -->
            <Label fx:id="passwordErrorLabel" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" visible="false"/>
        </VBox>

        <!-- Champ Confirmation -->
        <VBox spacing="5" alignment="CENTER_LEFT" maxWidth="400">
            <Label text="Confirmer le mot de passe" style="-fx-text-fill: #2c3e50;"/>
            <PasswordField fx:id="confirmPasswordField"
                           style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7; -fx-padding: 10px;"
                           maxWidth="400" prefWidth="400">
                <font>
                    <Font size="14.0" />
                </font>
            </PasswordField>
            <!-- Message d'erreur pour la confirmation -->
            <Label fx:id="confirmErrorLabel" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" visible="false"/>
        </VBox>

        <!-- Boutons (élargis) -->
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
            <Button fx:id="cancelButton" text="Annuler"
                    onAction="#handleCancel"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 0 30;"
                    prefHeight="45" minWidth="180">
                <font>
                    <Font size="14.0" />
                </font>
            </Button>

            <Button fx:id="resetButton" text="Valider"
                    onAction="#handleResetPassword"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 0 30;"
                    prefHeight="45" minWidth="180">
                <font>
                    <Font size="14.0" />
                </font>
            </Button>
        </HBox>

        <!-- Message d'information général -->
        <Label fx:id="infoLabel" text=""
               style="-fx-text-fill: #3498db; -fx-font-style: italic; -fx-font-size: 12px;"
               maxWidth="400" textAlignment="CENTER" wrapText="true"/>
    </VBox>
</StackPane>