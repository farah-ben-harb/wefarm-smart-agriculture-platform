<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.User.StatsCnxController"
            style="-fx-background-color: #f5f5f5;"
            prefHeight="700"
            prefWidth="1200">
    <left>
        <fx:include  source="../navbarBack.fxml" />

    </left>
    <center>
    <VBox spacing="15" style="-fx-padding: 20;" >
    <!-- En-tête -->
    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0 20 0;">

    <!--barre sup-->
    <!-- Barre supérieure -->
    <HBox fx:id="searchBarHBox" spacing="0" alignment="CENTER" style="-fx-background-color: #ffffff; -fx-padding: 0 0; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;">
        <!-- Groupe recherche + bouton aligné à gauche -->
        <HBox spacing="5" alignment="CENTER">
            <!-- Champ de recherche avec style transparent -->
            <TextField  promptText="Rechercher..."
                        style="
                         -fx-pref-width: 400px;
                         -fx-background-radius: 20;
                         -fx-border-radius: 20;
                         -fx-padding: 8 15;
                         -fx-background-color: rgba(0,0,0,0.05);
                         -fx-prompt-text-fill: #a0a0a0;
                     "/>

            <!-- Bouton recherche vert -->
            <Button text="🔍"
                    style="
                       -fx-background-radius: 20;
                       -fx-padding: 8 15;
                       -fx-min-width: 40px;
                       -fx-background-color: #1cc88a;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                   "/>
        </HBox>

        <!-- Espace étirable pour repousser les autres éléments à droite -->
        <Region HBox.hgrow="ALWAYS" />

        <!-- Bouton notification style discret -->
        <Button  text="🔔"
                 style="
                           -fx-padding: 15 20;
                            -fx-min-width: 60px;
                            -fx-min-height: 60px;
                            -fx-background-color: transparent;
                            -fx-text-fill: #d1d3e2;
                            -fx-font-size: 18px;
                            -fx-cursor: hand;
                       "/>

        <!-- Bouton message style discret -->
        <Button text="📩"
                style="
                            -fx-padding: 15 20;
                            -fx-min-width: 60px;
                            -fx-min-height: 60px;
                            -fx-background-color: transparent;
                            -fx-text-fill: #d1d3e2;
                            -fx-font-size: 24px;
                            -fx-cursor: hand;
                        "/>

        <!-- Séparateur avant le menu admin -->
        <Separator orientation="VERTICAL" style="-fx-padding: 0 10px;" />

        <!-- Menu admin avec texte gris -->
        <MenuButton style="-fx-background-color: transparent;" HBox.hgrow="NEVER">
            <graphic>
                <HBox spacing="5" alignment="CENTER">
                    <Label text="Admin" style="-fx-text-fill: #858796; -fx-font-size: 14px;" />
                    <ImageView fitHeight="28" fitWidth="28">
                        <Image url="@/img/admin.png"/>
                    </ImageView>
                </HBox>
            </graphic>
            <items>
                <MenuItem text="Profil" />
                <MenuItem text="Paramètres" />
                <MenuItem text="Activité" />
                <SeparatorMenuItem />
                <MenuItem text="Déconnexion" />
            </items>
        </MenuButton>
    </HBox>
    <VBox alignment="CENTER"  spacing="60" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">


    <Label text="Statistiques Utilisateurs"  style="-fx-text-fill: #858796; -fx-font-weight: bold; -fx-font-size: 24;"/>



    <HBox spacing="70" alignment="CENTER">
        <VBox spacing="10" alignment="CENTER">
            <Label text="Répartition par type d'utilisateur" style="-fx-text-fill: #858796; -fx-font-weight: bold; -fx-font-size: 18;"/>
            <PieChart fx:id="chartUserTypes" prefHeight="300" prefWidth="400"/>
        </VBox>

        <VBox spacing="10" alignment="CENTER">
            <Label text="Statut des comptes" style="-fx-text-fill: #858796; -fx-font-weight: bold; -fx-font-size: 18;"/>
            <PieChart fx:id="chartUserStatus" prefHeight="300" prefWidth="400"/>
        </VBox>
    </HBox>
    </VBox>
    </VBox>
    </VBox>
    </center>
</BorderPane>