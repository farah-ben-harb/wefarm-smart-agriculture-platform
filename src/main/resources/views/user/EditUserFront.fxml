<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Rectangle?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.User.EditUserFrontController"
      alignment="TOP_CENTER" spacing="15"
      style="-fx-background-color: #e9f5e9; -fx-padding: 30px;"
      prefWidth="520" prefHeight="680">

    <!-- Titre -->
    <Label text="🌿 MODIFICATION DU PROFIL"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2d572c;
                  -fx-font-family: 'Segoe UI', sans-serif;"/>

    <!-- Conteneur formulaire -->
    <VBox spacing="20" alignment="CENTER"
          style="-fx-padding: 25px; -fx-background-color: white; -fx-background-radius: 15px;
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">

        <!-- Image de profil -->
        <StackPane alignment="CENTER">
            <Rectangle width="160" height="160"
                       fill="white" stroke="#c8e6c9" strokeWidth="2"
                       arcWidth="15" arcHeight="15"/>
            <ImageView fx:id="profileImage" onMouseClicked="#handleImageClick"
                       fitHeight="150" fitWidth="150" preserveRatio="true"
                       style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 5, 0, 0, 2);"/>
        </StackPane>

        <!-- Champs -->
        <VBox spacing="18" alignment="CENTER_LEFT" style="-fx-pref-width: 320px;">

            <!-- Champs -->
            <HBox spacing="30" alignment="CENTER">

                <!-- Colonne gauche -->
                <VBox spacing="5" alignment="CENTER_LEFT">

                    <!-- Email -->
                    <VBox spacing="2">
                        <HBox spacing="30" alignment="CENTER_LEFT">
                            <Label text="Email:" style="-fx-font-weight: bold; -fx-text-fill: #2d572c;"/>
                            <TextField fx:id="emailField" style="-fx-pref-width: 200px; -fx-background-radius: 10px;
                             -fx-font-size: 16px;"/>
                        </HBox>
                        <Label fx:id="emailError" style="-fx-text-fill: #d32f2f; -fx-font-size: 12px; -fx-padding: 0 0 0 80;"/>
                    </VBox>

                    <!-- Prénom -->
                    <VBox spacing="2">
                        <HBox spacing="18" alignment="CENTER_LEFT">
                            <Label text="Prénom:" style="-fx-font-weight: bold; -fx-text-fill: #2d572c;"/>
                            <TextField fx:id="firstNameField" style="-fx-pref-width: 200px; -fx-background-radius: 10px;
                             -fx-font-size: 16px;"/>
                        </HBox>
                        <Label fx:id="firstNameError" style="-fx-text-fill: #d32f2f; -fx-font-size: 12px; -fx-padding: 0 0 0 80;"/>
                    </VBox>

                    <!-- Nom -->
                    <VBox spacing="2">
                        <HBox spacing="33" alignment="CENTER_LEFT">
                            <Label text="Nom:" style="-fx-font-weight: bold; -fx-text-fill: #2d572c;"/>
                            <TextField fx:id="lastNameField" style="-fx-pref-width: 200px; -fx-background-radius: 10px;
                             -fx-font-size: 16px;"/>
                        </HBox>
                        <Label fx:id="lastNameError" style="-fx-text-fill: #d32f2f; -fx-font-size: 12px; -fx-padding: 0 0 0 80;"/>
                    </VBox>

                </VBox>

                <!-- Séparateur vertical -->
                <Separator orientation="VERTICAL"/>

                <!-- Colonne droite -->
                <VBox spacing="5" alignment="CENTER_LEFT">

                    <!-- Adresse -->
                    <VBox spacing="2">
                        <HBox spacing="18" alignment="CENTER_LEFT">
                            <Label text="Adresse:" style="-fx-font-weight: bold; -fx-text-fill: #2d572c;"/>
                            <TextField fx:id="adresseField" style="-fx-pref-width: 200px; -fx-background-radius: 10px;
                             -fx-font-size: 16px;"/>
                        </HBox>
                        <Label fx:id="adresseError" style="-fx-text-fill: #d32f2f; -fx-font-size: 12px; -fx-padding: 0 0 0 80;"/>
                    </VBox>

                    <!-- Téléphone -->
                    <VBox spacing="2">
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Label text="Téléphone:" style="-fx-font-weight: bold; -fx-text-fill: #2d572c;"/>
                            <TextField fx:id="numTelField" style="-fx-pref-width: 200px; -fx-background-radius: 10px;
                             -fx-font-size: 16px;"/>
                        </HBox>
                        <Label fx:id="numTelError" style="-fx-text-fill: #d32f2f; -fx-font-size: 12px; -fx-padding: 0 0 0 80;"/>
                    </VBox>

                </VBox>

            </HBox>

        </VBox>

        <!-- Boutons -->
        <HBox alignment="CENTER" spacing="25" style="-fx-padding: 15px 0 0 0;">
            <Button text="Annuler" onAction="#handleCancel"
                    style="-fx-background-color: #a5d6a7; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-padding: 8 25; -fx-background-radius: 20px;
                           -fx-font-size: 14px;"/>
            <Button text="💾 Enregistrer" onAction="#handleSave"
                    style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-padding: 8 25; -fx-background-radius: 20px;
                           -fx-font-size: 14px;"/>
        </HBox>

    </VBox>
</VBox>