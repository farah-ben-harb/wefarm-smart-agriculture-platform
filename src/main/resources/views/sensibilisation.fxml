<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.media.MediaView?>
<AnchorPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.SensibilisationController">

    <BorderPane prefWidth="800.0" prefHeight="600.0" style="-fx-background-color: #f5f5f5;" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- HEADER -->
        <top>
            <StackPane style="-fx-background-color: #2E8B57; -fx-padding: 20;">
                <Label text="WeFarm et les Objectifs de Développement Durable"
                       style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
                <Button text="← retour" onAction="#goBackToLogin"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 5;-fx-cursor: hand"
                        StackPane.alignment="TOP_LEFT" />
            </StackPane>
        </top>

        <!-- CENTRE - Contenu principal avec scroll -->
        <center>
            <ScrollPane fitToWidth="true" style="-fx-background: #f5f5f5; -fx-border-color: transparent;">
                <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 20 40 40 40;">

                    <!-- Section ODD -->
                    <VBox alignment="TOP_CENTER" spacing="20">
                        <Label text="Comment WeFarm agit pour les ODD ?"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #158d54;" />

                        <HBox alignment="CENTER" spacing="40">

                            <!-- ODD 2 -->
                            <VBox alignment="CENTER" spacing="5"
                                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
                                  prefWidth="380" prefHeight="410">
                                <Label text="ODD 2 : Faim Zéro" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                <ImageView fitWidth="280" fitHeight="280">
                                    <image>
                                        <Image url="@../img/odd2.png" />
                                    </image>
                                </ImageView>
                                <Label text="Grâce à notre plateforme, les petits agriculteurs peuvent accéder à des ressources, échanger leurs récoltes et améliorer leur productivité."
                                       wrapText="true" style="-fx-text-fill: #555; -fx-padding: 5 0 0 0;" />
                            </VBox>

                            <!-- ODD 8 -->
                            <VBox alignment="CENTER" spacing="5"
                                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
                                  prefWidth="380" prefHeight="410">
                                <Label text="ODD 8 : Travail Décent" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                <ImageView fitWidth="280" fitHeight="280">
                                    <image>
                                        <Image url="@../img/odd8.png" />
                                    </image>
                                </ImageView>
                                <Label text="En créant des offres d'emploi locales dans l'agriculture, WeFarm favorise une croissance inclusive et durable."
                                       wrapText="true" style="-fx-text-fill: #555; -fx-padding: 5 0 0 0;" />
                            </VBox>

                            <!-- ODD 13 -->
                            <VBox alignment="CENTER" spacing="5"
                                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
                                  prefWidth="380" prefHeight="410">
                                <Label text="ODD 13 : Action Climat" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                <ImageView fitWidth="280" fitHeight="280">
                                    <image>
                                        <Image url="@../img/odd13.png" />
                                    </image>
                                </ImageView>
                                <Label text="Nos formations et événements encouragent l'agroécologie et l'adoption de pratiques agricoles respectueuses du climat."
                                       wrapText="true" style="-fx-text-fill: #555; -fx-padding: 5 0 0 0;" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Section Statistiques -->
                    <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
                        <!-- Titre avec icône -->
                        <HBox alignment="CENTER" spacing="10">
                            <ImageView fitWidth="30" fitHeight="30">
                                <image>
                                    <Image url="@../img/stats-icon.png" />
                                </image>
                            </ImageView>
                            <Label text="Impact de WeFarm en Tunisie"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2E8B57;" />
                        </HBox>

                        <!-- Conteneur des statistiques -->
                        <VBox maxWidth="1000" alignment="TOP_CENTER" spacing="30" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                            <!-- Statistique 1 - Emploi -->
                            <HBox alignment="CENTER_LEFT" spacing="30">
                                <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #E8F5E9; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="300">
                                    <Label text="📉 18.4%" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2E8B57;" />
                                    <Label text="Taux de chômage agricole" style="-fx-font-weight: bold;" />
                                </VBox>
                                <VBox alignment="TOP_LEFT" spacing="10" prefWidth="400">
                                    <Label text="Notre solution :" style="-fx-font-weight: bold; -fx-text-fill: #2E8B57;" />
                                    <Label text="WeFarm connecte directement les agriculteurs avec les employeurs. Plusieurs emplois dans le secteur agricole grâce à notre plateforme de matching."
                                           wrapText="true" style="-fx-text-fill: #555;" />
                                    <ProgressBar progress="0.4" style="-fx-accent: #4CAF50; -fx-pref-height: 10;" prefWidth="400"/>
                                </VBox>
                            </HBox>

                            <!-- Statistique 2 - Produits naturels -->
                            <HBox alignment="CENTER_LEFT" spacing="30">
                                <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #E8F5E9; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="300">
                                    <Label text="🥔 +65%" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2E8B57;" />
                                    <Label text="Consommation de produits locaux" style="-fx-font-weight: bold;" />
                                </VBox>
                                <VBox alignment="TOP_LEFT" spacing="10" prefWidth="400">
                                    <Label text="Notre solution :" style="-fx-font-weight: bold; -fx-text-fill: #2E8B57;" />
                                    <Label text="Notre marketplace permet aux agriculteurs de vendre directement leurs produits. Les producteurs peuvent rapidement augumenter leurs revenus ."
                                           wrapText="true" style="-fx-text-fill: #555;" />
                                    <HBox spacing="15" alignment="CENTER_LEFT">
                                        <ImageView fitWidth="80" fitHeight="80" preserveRatio="true">
                                            <image>
                                                <Image url="@../img/organic-products.png" />
                                            </image>
                                        </ImageView>
                                        <Label text="Paniers bio à livrer chaque semaine à plusieurs foyers"
                                               wrapText="true" style="-fx-text-fill: #555; -fx-font-style: italic;" />
                                    </HBox>
                                </VBox>
                            </HBox>

                            <!-- Statistique 3 - Recyclage -->
                            <HBox alignment="CENTER_LEFT" spacing="30">
                                <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #E8F5E9; -fx-background-radius: 10; -fx-padding: 15;" prefWidth="300">
                                    <Label text="♻ 3.2T" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2E8B57;" />
                                    <Label text="Déchets recyclés mensuellement" style="-fx-font-weight: bold;" />
                                </VBox>
                                <VBox alignment="TOP_LEFT" spacing="10" prefWidth="400">
                                    <Label text="Notre innovation :" style="-fx-font-weight: bold; -fx-text-fill: #2E8B57;" />
                                    <Label text="Le programme 'Paniers de recyclage' permet de collecter les invendus et déchets agricoles pour les transformer en compost ou en emballages écologiques."
                                           wrapText="true" style="-fx-text-fill: #555;" />
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Circle radius="8" fill="#4CAF50" />
                                        <Label text="Fermes partenaires" style="-fx-text-fill: #555;" />
                                        <Circle radius="8" fill="#8BC34A" style="-fx-margin: 0 0 0 15;" />
                                        <Label text="Centres de collecte" style="-fx-text-fill: #555;" />
                                        <Circle radius="8" fill="#CDDC39" style="-fx-margin: 0 0 0 15;" />
                                        <Label text="Produits recyclés" style="-fx-text-fill: #555;" />
                                    </HBox>
                                </VBox>
                            </HBox>


                        </VBox>
                    </VBox>
                    <!-- Conteneur de la vidéo et description -->
                    <VBox alignment="TOP_CENTER" spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" maxWidth="1000">

                        <!-- Conteneur MediaView simplifié -->
                        <MediaView fx:id="mediaView" fitWidth="800" fitHeight="450" style="-fx-background-color: black;"/>

                        <!-- Description et appel à l'action -->
                        <VBox spacing="10" style="-fx-padding: 10 20 0 20;">
                            <Label text="Rejoignez le mouvement pour une agriculture durable !"
                                   style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #2E8B57;"/>

                            <Label text="Cette vidéo montre comment chacun peut contribuer à un système alimentaire plus durable en soutenant les petits agriculteurs locaux, en réduisant le gaspillage et en adoptant des habitudes de consommation responsables."
                                   wrapText="true" style="-fx-text-fill: #555;"/>

                            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 15 0 0 0;">
                                <Button fx:id="playButton" text="▶ Lire la vidéo"
                                        style="-fx-background-color: #2E8B57; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;"
                                        onAction="#playVideo"/>


                            </HBox>
                        </VBox>
                    </VBox>
                    </VBox>
            </ScrollPane>
        </center>
    </BorderPane>
</AnchorPane>