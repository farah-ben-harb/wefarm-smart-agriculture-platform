<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.marketplace.ProduitManagementController"
      style="-fx-background-color: #f5f5f5;">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>

    <!-- Header with title and commands button -->
    <BorderPane style="-fx-padding: 0 0 15 0;">
        <left>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Gestion des Produits" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #343a40; -fx-font-family: 'Segoe UI';"/>
            </HBox>
        </left>
        <right>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="adsBtn" text="Gérer les Publicités" onAction="#handleShowAds"
                        style="-fx-background-color: #fd7e14; -fx-text-fill: white;">
                    <graphic>
                        <Label text="🎯" style="-fx-font-size: 14;"/>
                    </graphic>
                </Button>
                <Button fx:id="statisticsBtn" text="Statistiques" onAction="#handleShowStatistics"
                        style="-fx-background-color: #6610f2; -fx-text-fill: white;">
                    <graphic>
                        <Label text="📊" style="-fx-font-size: 14;"/>
                    </graphic>
                </Button>
                <Button fx:id="refreshBtn" text="Rafraîchir" onAction="#handleRefresh"
                        style="-fx-background-color: #17a2b8; -fx-text-fill: white;">
                    <graphic>
                        <Label text="🔄" style="-fx-font-size: 14;"/>
                    </graphic>
                </Button>
                <Button fx:id="commandesBtn" text="Voir les Commandes" onAction="#handleShowCommandes"
                        style="-fx-background-color: #28a745; -fx-text-fill: white;">
                    <graphic>
                        <Label text="📋" style="-fx-font-size: 14;"/>
                    </graphic>
                </Button>
            </HBox>
        </right>
    </BorderPane>

    <HBox spacing="20">
        <!-- Left side - Input Form -->
        <VBox spacing="10" minWidth="300" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
            <Label text="Détails du Produit" style="-fx-font-size: 16; -fx-font-weight: bold"/>

            <Label text="Nom"/>
            <TextField fx:id="nomField" promptText="Nom du produit"/>

            <Label text="Quantité"/>
            <TextField fx:id="quantiteField" promptText="Quantité disponible"/>

            <Label text="Prix Total"/>
            <TextField fx:id="prixTotalField" promptText="Prix en DT"/>

            <Label text="Description"/>
            <TextArea fx:id="descriptionArea" wrapText="true" prefRowCount="3"
                      promptText="Description du produit"/>

            <Label text="Catégorie"/>
            <ComboBox fx:id="categorieCombo" maxWidth="Infinity"/>

            <Label text="État du Stock"/>
            <ComboBox fx:id="stockDCombo" maxWidth="Infinity"/>

            <Label text="Image"/>
            <HBox spacing="10">
                <TextField fx:id="imageField" HBox.hgrow="ALWAYS" promptText="Chemin de l'image"/>
                <Button fx:id="imageChooserBtn" text="Parcourir"
                        style="-fx-background-color: #6c757d; -fx-text-fill: white;"/>
            </HBox>
            <ImageView fx:id="imagePreview" fitHeight="100" fitWidth="150" preserveRatio="true"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="addBtn" text="Ajouter" onAction="#handleAdd"
                        style="-fx-background-color: #28a745; -fx-text-fill: white;"/>
                <Button fx:id="updateBtn" text="Modifier" onAction="#handleUpdate"
                        style="-fx-background-color: #ffc107;"/>
                <Button fx:id="deleteBtn" text="Supprimer" onAction="#handleDelete"
                        style="-fx-background-color: #dc3545; -fx-text-fill: white;"/>
                <Button fx:id="clearBtn" text="Effacer" onAction="#handleClear"
                        style="-fx-background-color: #6c757d; -fx-text-fill: white;"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="approveBtn" text="Approuver" onAction="#handleApprove"
                        style="-fx-background-color: #28a745; -fx-text-fill: white;"/>
                <Button fx:id="disapproveBtn" text="Désapprouver" onAction="#handleDisapprove"
                        style="-fx-background-color: #dc3545; -fx-text-fill: white;"/>
            </HBox>
        </VBox>

        <!-- Right side - Table View -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
            <Label text="Liste des Produits" style="-fx-font-size: 16; -fx-font-weight: bold"/>

            <TextField fx:id="searchField" promptText="Rechercher un produit..."/>

            <TableView fx:id="produitTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="nomCol" text="Nom" prefWidth="150"/>
                    <TableColumn fx:id="quantiteCol" text="Quantité" prefWidth="80"/>
                    <TableColumn fx:id="prixTotalCol" text="Prix Total" prefWidth="100"/>
                    <TableColumn fx:id="descriptionCol" text="Description" prefWidth="200"/>
                    <TableColumn fx:id="imageCol" text="Image" prefWidth="100"/>
                    <TableColumn fx:id="categorieCol" text="Catégorie" prefWidth="100"/>
                    <TableColumn fx:id="stockDCol" text="État du Stock" prefWidth="100"/>
                    <TableColumn fx:id="approvedCol" text="Approuvé" prefWidth="80"/>
                    <TableColumn fx:id="updatedAtCol" text="Mis à jour le" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>