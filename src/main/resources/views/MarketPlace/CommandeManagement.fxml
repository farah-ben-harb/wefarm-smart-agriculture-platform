<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.marketplace.CommandeManagementController"
      style="-fx-background-color: #f5f5f5; -fx-padding: 15;">

    <Label text="Gestion des Commandes" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox spacing="20">
        <!-- Left side - Form -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;"
              HBox.hgrow="ALWAYS" maxWidth="400">
            <Label text="Nouvelle Commande" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <GridPane vgap="10" hgap="10">
                <Label text="Client ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="clientIdField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                           style="-fx-background-radius: 3;"/>

                <Label text="Produit:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="produitCombo" GridPane.columnIndex="1" GridPane.rowIndex="1"
                          maxWidth="Infinity" style="-fx-background-radius: 3;"/>

                <Label text="Quantité:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="quantiteField" GridPane.columnIndex="1" GridPane.rowIndex="2"
                           style="-fx-background-radius: 3;"/>

                <Label text="Prix Total:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="prixField" GridPane.columnIndex="1" GridPane.rowIndex="3"
                           editable="false" style="-fx-background-color: #f8f9fa; -fx-background-radius: 3;"/>

                <Label text="Statut:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <ComboBox fx:id="statutCombo" GridPane.columnIndex="1" GridPane.rowIndex="4"
                          maxWidth="Infinity" style="-fx-background-radius: 3;"/>

                <Label text="Mode de Paiement:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <ComboBox fx:id="modePaiementCombo" GridPane.columnIndex="1" GridPane.rowIndex="5"
                          maxWidth="Infinity" style="-fx-background-radius: 3;"/>

                <Label text="Adresse de Livraison:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <TextField fx:id="adresseLivraisonField" GridPane.columnIndex="1" GridPane.rowIndex="6"
                           style="-fx-background-radius: 3;"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="clearBtn" text="Effacer" onAction="#handleClear"
                        style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 3;"/>
                <Button fx:id="deleteBtn" text="Supprimer" onAction="#handleDelete"
                        style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 3;"/>
                <Button fx:id="updateBtn" text="Modifier" onAction="#handleUpdate"
                        style="-fx-background-color: #ffc107; -fx-background-radius: 3;"/>
                <Button fx:id="addBtn" text="Ajouter" onAction="#handleAdd"
                        style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 3;"/>
            </HBox>
        </VBox>

        <!-- Right side - Table -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Rechercher:" style="-fx-font-size: 14px;"/>
                <TextField fx:id="searchField" HBox.hgrow="ALWAYS"
                           style="-fx-background-radius: 3;" promptText="Rechercher une commande..."/>
            </HBox>

            <TableView fx:id="commandeTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 3;">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="clientIdCol" text="Client ID" prefWidth="75"/>
                    <TableColumn fx:id="produitCol" text="Produit" prefWidth="150"/>
                    <TableColumn fx:id="quantiteCol" text="Quantité" prefWidth="75"/>
                    <TableColumn fx:id="prixCol" text="Prix Total" prefWidth="100"/>
                    <TableColumn fx:id="statutCol" text="Statut" prefWidth="100"/>
                    <TableColumn fx:id="dateCommandeCol" text="Date Commande" prefWidth="150"/>
                    <TableColumn fx:id="modePaiementCol" text="Mode Paiement" prefWidth="120"/>
                    <TableColumn fx:id="adresseLivraisonCol" text="Adresse Livraison" prefWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>