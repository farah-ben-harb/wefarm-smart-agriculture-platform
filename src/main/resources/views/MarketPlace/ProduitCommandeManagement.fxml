<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.marketplace.ProduitCommandeManagementController"
      style="-fx-background-color: linear-gradient(to bottom, #f8f9fa, #e9ecef);"
      stylesheets="@../../styles/marketplace.css">

    <!-- Header Section with Logo and Title -->
    <BorderPane style="-fx-background-color: #343a40; -fx-padding: 15;">
        <left>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
                    <image>
                        <Image url="@../../img/marketplace-icon.png" />
                    </image>
                </ImageView>
                <Label text="Gestion des Produits et Commandes" style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
            </HBox>
        </left>
        <right>
            <Button text="Retour au Marketplace" style="-fx-background-color: #6c757d; -fx-text-fill: white;" onAction="#handleReturnToMarketplace" />
        </right>
    </BorderPane>

    <!-- Main Content Area -->
    <VBox spacing="20" style="-fx-padding: 20;" VBox.vgrow="ALWAYS">
        <!-- Tab Pane for Products and Orders -->
        <TabPane fx:id="mainTabPane" style="-fx-background-color: transparent; -fx-padding: 0;">
            <tabs>
                <!-- Products Tab -->
                <Tab text="Produits" closable="false">
                    <content>
                        <VBox spacing="15">
                            <!-- Search and Action Bar -->
                            <BorderPane style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                                <left>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <TextField fx:id="productSearchField" promptText="Rechercher un produit..."
                                                   style="-fx-background-radius: 20; -fx-pref-width: 300; -fx-padding: 8 15;">
                                            <padding>
                                                <Insets left="15" />
                                            </padding>
                                        </TextField>
                                        <Button fx:id="productFilterBtn" text="Filtres" style="-fx-background-color: #6c757d; -fx-text-fill: white;">
                                            <graphic>
                                                <Label text="⚙" style="-fx-font-size: 14;"/>
                                            </graphic>
                                        </Button>
                                    </HBox>
                                </left>
                                <right>
                                    <HBox spacing="10" alignment="CENTER_RIGHT">
                                        <Button fx:id="refreshProductsBtn" text="Rafraîchir" onAction="#handleRefreshProducts"
                                                style="-fx-background-color: #17a2b8; -fx-text-fill: white;">
                                            <graphic>
                                                <Label text="↻" style="-fx-font-size: 14;"/>
                                            </graphic>
                                        </Button>
                                        <Button fx:id="addProductBtn" text="Ajouter un produit" onAction="#handleAddProduct"
                                                style="-fx-background-color: #28a745; -fx-text-fill: white;">
                                            <graphic>
                                                <Label text="+" style="-fx-font-size: 14;"/>
                                            </graphic>
                                        </Button>
                                    </HBox>
                                </right>
                            </BorderPane>

                            <!-- Products Table -->
                            <TableView fx:id="productTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                                <columns>
                                    <TableColumn fx:id="idCol" text="ID" prefWidth="50">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="id" />
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="nomCol" text="Nom" prefWidth="150">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="nom" />
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="quantiteCol" text="Quantité" prefWidth="80">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="quantite" />
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="prixTotalCol" text="Prix (DT)" prefWidth="90">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="prixTotal" />
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="categorieCol" text="Catégorie" prefWidth="100">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="categorie" />
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="stockDCol" text="État" prefWidth="80">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="stockD" />
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="approvedCol" text="Approuvé" prefWidth="80">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="approved" />
                                        </cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>

                            <!-- Product Form -->
                            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                                <Label text="Détails du Produit" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                
                                <GridPane hgap="15" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50"/>
                                        <ColumnConstraints percentWidth="50"/>
                                    </columnConstraints>
                                    
                                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="Nom" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                        <TextField fx:id="nomField" promptText="Nom du produit" style="-fx-background-radius: 4; -fx-padding: 8;"/>
                                    </VBox>
                                    
                                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="Catégorie" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                        <ComboBox fx:id="categorieCombo" style="-fx-background-radius: 4;"/>
                                    </VBox>
                                    
                                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Label text="Quantité" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                        <TextField fx:id="quantiteField" promptText="Quantité disponible" style="-fx-background-radius: 4; -fx-padding: 8;"/>
                                    </VBox>
                                    
                                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label text="Prix Total (DT)" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                        <TextField fx:id="prixTotalField" promptText="Prix en DT" style="-fx-background-radius: 4; -fx-padding: 8;"/>
                                    </VBox>
                                    
                                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                                        <Label text="Description" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                        <TextArea fx:id="descriptionArea" wrapText="true" prefRowCount="3"
                                                  promptText="Description du produit" style="-fx-background-radius: 4; -fx-padding: 8;"/>
                                    </VBox>
                                    
                                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="3">
                                        <Label text="État du Stock" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                        <ComboBox fx:id="stockDCombo" style="-fx-background-radius: 4;"/>
                                    </VBox>
                                    
                                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="3">
                                        <Label text="Image" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <TextField fx:id="imageField" HBox.hgrow="ALWAYS" promptText="Chemin de l'image" style="-fx-background-radius: 4 0 0 4; -fx-padding: 8;"/>
                                            <Button fx:id="imageChooserBtn" text="Parcourir" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 0 4 4 0;"/>
                                        </HBox>
                                    </VBox>
                                </GridPane>
                                
                                <ImageView fx:id="imagePreview" fitHeight="120" fitWidth="180" preserveRatio="true" style="-fx-border-color: #dee2e6; -fx-border-radius: 4; -fx-border-width: 1;"/>
                                
                                <!-- Product Action Buttons -->
                                <HBox spacing="10" alignment="CENTER_RIGHT">
                                    <Button fx:id="addBtn" text="Ajouter" onAction="#handleAddProduct" style="-fx-background-color: #28a745; -fx-text-fill: white;"/>
                                    <Button fx:id="updateBtn" text="Modifier" onAction="#handleUpdateProduct" style="-fx-background-color: #ffc107; -fx-text-fill: white;"/>
                                    <Button fx:id="deleteBtn" text="Supprimer" onAction="#handleDeleteProduct" style="-fx-background-color: #dc3545; -fx-text-fill: white;"/>
                                    <Button fx:id="clearBtn" text="Effacer" onAction="#handleClearProduct" style="-fx-background-color: #6c757d; -fx-text-fill: white;"/>
                                </HBox>
                                
                                <!-- Approval Buttons -->
                                <HBox spacing="10" alignment="CENTER">
                                    <Button fx:id="approveBtn" text="Approuver" onAction="#handleApproveProduct" style="-fx-background-color: #28a745; -fx-text-fill: white;">
                                        <graphic>
                                            <Label text="✓" style="-fx-font-size: 14;"/>
                                        </graphic>
                                    </Button>
                                    <Button fx:id="disapproveBtn" text="Désapprouver" onAction="#handleDisapproveProduct" style="-fx-background-color: #dc3545; -fx-text-fill: white;">
                                        <graphic>
                                            <Label text="✕" style="-fx-font-size: 14;"/>
                                        </graphic>
                                    </Button>
                                </HBox>
                            </VBox>
                        </VBox>
                    </content>
                </Tab>
                
                <!-- Orders Tab -->
                <Tab text="Commandes" closable="false">
                    <content>
                        <VBox spacing="15">
                            <!-- Search and Action Bar -->
                            <BorderPane style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                                <left>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <TextField fx:id="orderSearchField" promptText="Rechercher une commande..."
                                                   style="-fx-background-radius: 20; -fx-pref-width: 300; -fx-padding: 8 15;">
                                            <padding>
                                                <Insets left="15" />
                                            </padding>
                                        </TextField>
                                        <ComboBox fx:id="statusFilterCombo" promptText="Filtrer par statut" style="-fx-background-radius: 20;"/>
                                    </HBox>
                                </left>
                                <right>
                                    <HBox spacing="10" alignment="CENTER_RIGHT">
                                        <Button fx:id="refreshOrdersBtn" text="Rafraîchir" onAction="#handleRefreshOrders"
                                                style="-fx-background-color: #17a2b8; -fx-text-fill: white;">
                                            <graphic>
                                                <Label text="↻" style="-fx-font-size: 14;"/>
                                            </graphic>
                                        </Button>
                                        <Button fx:id="addOrderBtn" text="Nouvelle commande" onAction="#handleAddOrder"
                                                style="-fx-background-color: #28a745; -fx-text-fill: white;">
                                            <graphic>
                                                <Label text="+" style="-fx-font-size: 14;"/>
                                            </graphic>
                                        </Button>
                                    </HBox>
                                </right>
                            </BorderPane>

                            <!-- Orders Table -->
                            <TableView fx:id="orderTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                                <columns>
                                    <TableColumn fx:id="orderIdCol" text="ID" prefWidth="50">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="id" />
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="orderDateCol" text="Date" prefWidth="120">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="dateCommande" />
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="orderProductCol" text="Produit" prefWidth="150">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="produitId" />
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="orderClientCol" text="Client" prefWidth="100">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="clientId" />
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="orderQuantityCol" text="Quantité" prefWidth="80">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="quantite" />
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="orderStatusCol" text="Statut" prefWidth="100">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="status" />
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="orderPaymentCol" text="Paiement" prefWidth="100">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="modePaiement" />
                                        </cellValueFactory>
                                    </TableColumn>
                                    <TableColumn fx:id="orderTotalCol" text="Total (DT)" prefWidth="90">
                                        <cellValueFactory>
                                            <PropertyValueFactory property="prixTotal" />
                                        </cellValueFactory>
                                    </TableColumn>
                                </columns>
                            </TableView>

                            <!-- Order Form -->
                            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                                <Label text="Détails de la Commande" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                
                                <GridPane hgap="15" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50"/>
                                        <ColumnConstraints percentWidth="50"/>
                                    </columnConstraints>
                                    
                                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="Produit" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                        <ComboBox fx:id="orderProductCombo" style="-fx-background-radius: 4;"/>
                                    </VBox>
                                    
                                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="Client" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                        <ComboBox fx:id="orderClientCombo" style="-fx-background-radius: 4;"/>
                                    </VBox>
                                    
                                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Label text="Quantité" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                        <TextField fx:id="orderQuantityField" promptText="Quantité commandée" style="-fx-background-radius: 4; -fx-padding: 8;"/>
                                    </VBox>
                                    
                                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label text="Statut" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                        <ComboBox fx:id="orderStatusCombo" style="-fx-background-radius: 4;"/>
                                    </VBox>
                                    
                                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="2">
                                        <Label text="Mode de Paiement" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                        <ComboBox fx:id="orderPaymentCombo" style="-fx-background-radius: 4;"/>
                                    </VBox>
                                    
                                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="2">
                                        <Label text="Prix Total (DT)" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                        <TextField fx:id="orderTotalField" promptText="Prix total" style="-fx-background-radius: 4; -fx-padding: 8;"/>
                                    </VBox>
                                    
                                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                                        <Label text="Adresse de Livraison" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                                        <TextField fx:id="orderAddressField" promptText="Adresse de livraison" style="-fx-background-radius: 4; -fx-padding: 8;"/>
                                    </VBox>
                                </GridPane>
                                
                                <!-- Order Action Buttons -->
                                <HBox spacing="10" alignment="CENTER_RIGHT">
                                    <Button fx:id="addOrderBtn2" text="Ajouter" onAction="#handleAddOrder" style="-fx-background-color: #28a745; -fx-text-fill: white;"/>
                                    <Button fx:id="updateOrderBtn" text="Modifier" onAction="#handleUpdateOrder" style="-fx-background-color: #ffc107; -fx-text-fill: white;"/>
                                    <Button fx:id="deleteOrderBtn" text="Supprimer" onAction="#handleDeleteOrder" style="-fx-background-color: #dc3545; -fx-text-fill: white;"/>
                                    <Button fx:id="clearOrderBtn" text="Effacer" onAction="#handleClearOrder" style="-fx-background-color: #6c757d; -fx-text-fill: white;"/>
                                </HBox>
                                
                                <!-- Order Status Buttons -->
                                <HBox spacing="10" alignment="CENTER">
                                    <Button fx:id="confirmOrderBtn" text="Confirmer" onAction="#handleConfirmOrder" style="-fx-background-color: #28a745; -fx-text-fill: white;">
                                        <graphic>
                                            <Label text="✓" style="-fx-font-size: 14;"/>
                                        </graphic>
                                    </Button>
                                    <Button fx:id="cancelOrderBtn" text="Annuler" onAction="#handleCancelOrder" style="-fx-background-color: #dc3545; -fx-text-fill: white;">
                                        <graphic>
                                            <Label text="✕" style="-fx-font-size: 14;"/>
                                        </graphic>
                                    </Button>
                                    <Button fx:id="shipOrderBtn" text="Expédier" onAction="#handleShipOrder" style="-fx-background-color: #0275d8; -fx-text-fill: white;">
                                        <graphic>
                                            <Label text="🚚" style="-fx-font-size: 14;"/>
                                        </graphic>
                                    </Button>
                                </HBox>
                            </VBox>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </VBox>

    <!-- Status Bar -->
    <BorderPane style="-fx-background-color: #343a40; -fx-padding: 8 15;">
        <left>
            <Label text="© 2023 WeFarm" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12;"/>
        </left>
        <right>
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Label text="Connecté en tant que: " style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12;"/>
                <Label fx:id="usernameLabel" style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold;"/>
            </HBox>
        </right>
    </BorderPane>
</VBox> 