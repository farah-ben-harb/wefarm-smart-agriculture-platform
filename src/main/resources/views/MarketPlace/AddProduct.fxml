<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.lang.String?>
<?import java.net.URL?>

<VBox spacing="20" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.marketplace.AddProductController">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Ajouter un Nouveau Produit" style="-fx-font-size: 24; -fx-font-weight: bold;"/>

    <GridPane hgap="15" vgap="15">
        <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nomField" promptText="Nom du produit" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Quantité:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="quantiteField" promptText="Quantité disponible" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Prix:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="prixField" promptText="Prix total" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextArea fx:id="descriptionArea" promptText="Description du produit" prefRowCount="3" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Image:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="4">
            <Label fx:id="imagePathLabel" text="Aucune image sélectionnée"/>
            <Button fx:id="selectImageBtn" text="Parcourir"/>
            <ProgressIndicator fx:id="uploadProgress" visible="false" prefHeight="20" prefWidth="20"/>
        </HBox>

        <Label text="Catégorie:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <ComboBox fx:id="categorieCombo" promptText="Sélectionner une catégorie" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <Label text="État du Stock:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <ComboBox fx:id="stockDCombo" promptText="Sélectionner l'état du stock" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
    </GridPane>

    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="saveBtn" text="Enregistrer" styleClass="add-button">
            <font>
                <Font size="14"/>
            </font>
        </Button>
        <Button fx:id="cancelBtn" text="Annuler" styleClass="clear-button">
            <font>
                <Font size="14"/>
            </font>
        </Button>
    </HBox>

    <stylesheets>
        <URL value="@../../styles/marketplace.css"/>
    </stylesheets>
</VBox> 