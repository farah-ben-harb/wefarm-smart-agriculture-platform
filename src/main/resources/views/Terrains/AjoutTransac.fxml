<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.terrains.AjoutTransac"
      spacing="15"
      alignment="CENTER"
      style="-fx-background-color: #ecf0f1; -fx-padding: 20;">

    <Label fx:id="terrainInfoLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="120"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="200"/>
        </columnConstraints>

        <Label text="Client:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="clientCombo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Type de transaction:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="typeCombo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Montant (DT):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="montantField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Date:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <DatePicker fx:id="datePicker" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="20" alignment="CENTER">
        <Button text="Valider" onAction="#handleValider" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 100;"/>
        <Button text="Annuler" onAction="#handleAnnuler" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 100;"/>
    </HBox>
</VBox>