<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane  xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.terrains.ListeTerrain">

    <!-- NavBar gauche -->
    <left>
        <fx:include source="../navbarBack.fxml" />
    </left>

    <!-- Contenu principal -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #f8f9fa;">
            <!-- Barre supérieure -->
            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-padding: 15 20; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;">
                <!-- Groupe recherche + bouton aligné à gauche -->
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <!-- Champ de recherche avec style transparent -->
                    <TextField  promptText="Rechercher..."
                                style="
                         -fx-pref-width: 400px;
                         -fx-background-radius: 20;
                         -fx-border-radius: 20;
                         -fx-padding: 8 15;
                         -fx-background-color: rgba(0,0,0,0.05);
                         -fx-prompt-text-fill: #a0a0a0;
                     "/>

                    <!-- Bouton recherche vert -->
                    <Button text="🔍"
                            style="
                       -fx-background-radius: 20;
                       -fx-padding: 8 15;
                       -fx-min-width: 40px;
                       -fx-background-color: #1cc88a;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                   "/>
                </HBox>

                <!-- Espace étirable pour repousser les autres éléments à droite -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Bouton notification style discret -->
                <Button  text="🔔"
                         style="
                           -fx-padding: 15 20;
                            -fx-min-width: 60px;
                            -fx-min-height: 60px;
                            -fx-background-color: transparent;
                            -fx-text-fill: #d1d3e2;
                            -fx-font-size: 18px;
                            -fx-cursor: hand;
                       "/>

                <!-- Bouton message style discret -->
                <Button text="📩"
                        style="
                            -fx-padding: 15 20;
                            -fx-min-width: 60px;
                            -fx-min-height: 60px;
                            -fx-background-color: transparent;
                            -fx-text-fill: #d1d3e2;
                            -fx-font-size: 24px;
                            -fx-cursor: hand;
                        "/>

                <!-- Séparateur avant le menu admin -->
                <Separator orientation="VERTICAL" style="-fx-padding: 0 10px;" />

                <!-- Menu admin avec texte gris -->
                <MenuButton style="-fx-background-color: transparent;" HBox.hgrow="NEVER">
                    <graphic>
                        <HBox spacing="5" alignment="CENTER">
                            <Label text="Admin" style="-fx-text-fill: #858796; -fx-font-size: 14px;" />
                            <ImageView fitHeight="28" fitWidth="28">
                                <Image url="@/img/admin.png"/>
                            </ImageView>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="Profil" />
                        <MenuItem text="Paramètres" />
                        <MenuItem text="Activité" />
                        <SeparatorMenuItem />
                        <MenuItem text="Déconnexion" />
                    </items>
                </MenuButton>
            </HBox>
            <!-- En-tête -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 0;">
                <Label text="Gestion des Terrains" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Separator orientation="VERTICAL" style="-fx-padding: 0 10;"/>
                <Label text="Tableau de bord" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
            </HBox>

            <!-- Tableau avec style -->
            <TableView fx:id="terrainTableView" style="-fx-font-size: 14px; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                <columns>
                    <!-- Colonne ID -->
                    <TableColumn fx:id="idCol" text="ID" prefWidth="50">
                        <cellValueFactory>
                            <PropertyValueFactory property="id"/>
                        </cellValueFactory>
                    </TableColumn>

                    <!-- Colonne Photo -->
                    <TableColumn fx:id="photoCol" text="Photo" prefWidth="100"/>

                    <!-- Colonne Adresse -->
                    <TableColumn fx:id="adresseCol" text="Adresse" prefWidth="200">
                        <cellValueFactory>
                            <PropertyValueFactory property="adresse"/>
                        </cellValueFactory>
                    </TableColumn>

                    <!-- Colonne Surface -->
                    <TableColumn fx:id="surfaceCol" text="Surface (m²)" prefWidth="100">
                        <cellValueFactory>
                            <PropertyValueFactory property="surface"/>
                        </cellValueFactory>
                        <style>
                            -fx-alignment: CENTER_RIGHT;
                        </style>
                    </TableColumn>

                    <!-- Colonne Type de sol -->
                    <TableColumn fx:id="typeSolCol" text="Type de Sol" prefWidth="120">
                        <cellValueFactory>
                            <PropertyValueFactory property="typeSol"/>
                        </cellValueFactory>
                    </TableColumn>

                    <!-- Colonne Prix -->
                    <TableColumn fx:id="prixCol" text="Prix (TND)" prefWidth="120">
                        <cellValueFactory>
                            <PropertyValueFactory property="prix"/>
                        </cellValueFactory>
                        <style>
                            -fx-alignment: CENTER_RIGHT;
                            -fx-text-fill: #27ae60;
                        </style>
                    </TableColumn>

                    <!-- Colonne Statut -->
                    <TableColumn fx:id="statusCol" text="Statut" prefWidth="120">
                        <cellValueFactory>
                            <PropertyValueFactory property="status"/>
                        </cellValueFactory>
                        <style>
                            -fx-font-weight: bold;
                            -fx-text-fill: #c0392b;
                        </style>
                    </TableColumn>

                    <!-- Colonnes Coordonnées -->
                    <TableColumn text="Coordonnées" prefWidth="200">
                        <columns>
                            <TableColumn fx:id="latitudeCol" text="Latitude" prefWidth="100">
                                <cellValueFactory>
                                    <PropertyValueFactory property="latitude"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="longitudeCol" text="Longitude" prefWidth="100">
                                <cellValueFactory>
                                    <PropertyValueFactory property="longitude"/>
                                </cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableColumn>

                    <!-- Colonne Actions -->
                    <TableColumn fx:id="actionsCol" text="Actions" prefWidth="150"/>
                </columns>

                <!-- Style des lignes -->
                <style>
                    .table-row-cell {
                    -fx-cell-size: 50px;
                    }
                    .table-row-cell:odd {
                    -fx-background-color: #f9f9f9;
                    }
                    .table-row-cell:selected {
                    -fx-background-color: #e3f2fd;
                    }
                </style>
            </TableView>

            <!-- Boutons d'action -->
            <!-- In your ListeTerrain.fxml, inside the HBox with action buttons -->
            <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                <Button text="Ajouter Terrain" onAction="#handleAddTerrain"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;"/>
                <Button text="Voir Transactions" onAction="#handleViewTransactions"
                        style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-padding: 8 15;"/>
                <Button text="Actualiser" onAction="#handleRefresh"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 8 15;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>