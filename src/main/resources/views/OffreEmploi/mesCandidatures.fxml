<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.OffreEmploi.MesCandidaturesController"
            stylesheets="@../../css/stylesOffresEmploi.css"
            prefHeight="600.0" prefWidth="800.0">

    <!-- Navbar -->
    <fx:include fx:id="navbar" source="../navbarFront.fxml" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20"/>

    <!-- Bouton de bascule dynamique -->
    <!-- Bouton de bascule unique -->
    <Button fx:id="toggleViewButton"
            style="-fx-background-color: transparent;-fx-border-color: transparent; -fx-cursor: hand; -fx-padding: 5;"
            onAction="#toggleView"
            AnchorPane.topAnchor="100.0"
            AnchorPane.rightAnchor="40.0">
        <graphic>
            <HBox alignment="CENTER" spacing="5">
                <Label fx:id="toggleViewLabel" />
                <ImageView fx:id="toggleViewIcon"
                           fitWidth="25"
                           fitHeight="25"
                           preserveRatio="true"
                >
                    <Image url="@../../icons/calendrier.png"/>
                </ImageView>
            </HBox>
        </graphic>
    </Button>

    <!-- Conteneur principal -->
    <StackPane fx:id="contentPane" AnchorPane.topAnchor="160" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20">

        <!-- Vue Tableau (par défaut) -->
        <VBox fx:id="tableView" spacing="15" alignment="TOP_CENTER">
            <!-- Conteneur blanc -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);"
                  minWidth="1200" maxWidth="750" minHeight="600" maxHeight="500">

                <!-- En-tête -->
                <HBox alignment="CENTER" style="-fx-padding: 0 0 10 0;">
                    <Label text="Mes Candidatures" styleClass="main-title"/>
                </HBox>

                <!-- Tableau des candidatures -->
                <TableView fx:id="candidaturesTable"
                           VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent;">

                    <!-- Colonnes -->
                    <columns>
                        <TableColumn fx:id="offreColumn" text="Offre" />
                        <TableColumn fx:id="dateColumn" text="Date" />
                        <TableColumn fx:id="etatColumn" text="État" />
                        <TableColumn fx:id="competencesColumn" text="Compétences" />
                        <TableColumn fx:id="actionsColumn" text="Actions" />
                    </columns>
                </TableView>
            </VBox>

            <!-- Bouton Retour -->
            <Button fx:id="retourButton"
                    style="-fx-background-color: transparent; -fx-text-fill: #858796; -fx-border-color: #d1d3e2; -fx-border-radius: 5; -fx-padding: 8 15; -fx-cursor: hand;"
                    text="Retour à la liste"
                    onAction="#handleRetour">
                <graphic>
                    <ImageView fitWidth="12" fitHeight="12" preserveRatio="true">
                        <Image url="@../../icons/retour.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </VBox>


        <!-- Vue Calendrier améliorée avec icônes -->
        <VBox fx:id="calendarView" spacing="15" visible="false" alignment="TOP_CENTER" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" maxWidth="900">
            <!-- En-tête avec bouton retour et titre centré -->
            <HBox alignment="CENTER" spacing="15" >
                <Button style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 5;" onAction="#retourTableau" >
                    <graphic>
                        <ImageView fitWidth="20" fitHeight="20" preserveRatio="true" >
                            <Image url="@../../icons/retour.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Label text="Calendrier des Candidatures" styleClass="main-title" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1b1a1a;"/>
            </HBox>

            <!-- Sélecteur de mois centré avec style amélioré -->
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 5 0 10 0; -fx-background-color: #f8f9fc; -fx-background-radius: 10;-fx-background-image: url('/icons/background_texture.jpg');-fx-background-size: cover;">
                <Button style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 5;" onAction="#moisPrecedent">
                    <graphic>
                        <ImageView fitWidth="12" fitHeight="12" preserveRatio="true">
                            <Image url="@../../icons/fleche-gauche.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Label fx:id="moisAnneeLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ddd9d9;"/>
                <Button style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 5;" onAction="#moisSuivant">
                    <graphic>
                        <ImageView fitWidth="12" fitHeight="12" preserveRatio="true">
                            <Image url="@../../icons/fleche-droite.png"/>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <!-- En-têtes des jours de la semaine -->
            <GridPane fx:id="dayHeadersGrid" hgap="5" vgap="5" style="-fx-padding: 0 0 0 180;">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60" prefWidth="40" maxWidth="40"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60" prefWidth="40" maxWidth="40"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60" prefWidth="40" maxWidth="40"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60" prefWidth="40" maxWidth="40"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60" prefWidth="40" maxWidth="40"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60" prefWidth="40" maxWidth="40"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60" prefWidth="40" maxWidth="40"/>
                </columnConstraints>
                <children>
                    <Label text="Lun" style="-fx-font-weight: bold; -fx-alignment: CENTER; -fx-text-fill: #5a5c69;"/>
                    <Label text="Mar" style="-fx-font-weight: bold; -fx-alignment: CENTER; -fx-text-fill: #5a5c69;" GridPane.columnIndex="1"/>
                    <Label text="Mer" style="-fx-font-weight: bold; -fx-alignment: CENTER; -fx-text-fill: #5a5c69;" GridPane.columnIndex="2"/>
                    <Label text="Jeu" style="-fx-font-weight: bold; -fx-alignment: CENTER; -fx-text-fill: #5a5c69;" GridPane.columnIndex="3"/>
                    <Label text="Ven" style="-fx-font-weight: bold; -fx-alignment: CENTER; -fx-text-fill: #5a5c69;" GridPane.columnIndex="4"/>
                    <Label text="Sam" style="-fx-font-weight: bold; -fx-alignment: CENTER; -fx-text-fill: #858796;" GridPane.columnIndex="5"/>
                    <Label text="Dim" style="-fx-font-weight: bold; -fx-alignment: CENTER; -fx-text-fill: #858796;" GridPane.columnIndex="6"/>
                </children>
            </GridPane>

            <!-- Grille du calendrier avec StackPane pour chaque cellule -->
            <GridPane fx:id="calendarGrid" hgap="5" vgap="5" style="-fx-padding: 0 0 0 150;">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60" prefWidth="40" maxWidth="40"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60" prefWidth="40" maxWidth="40"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60" prefWidth="40" maxWidth="40"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60" prefWidth="40" maxWidth="40"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60" prefWidth="40" maxWidth="40"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60" prefWidth="40" maxWidth="40"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="60" prefWidth="40" maxWidth="40"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints vgrow="ALWAYS" minHeight="60" prefHeight="40" maxHeight="40"/>
                    <RowConstraints vgrow="ALWAYS" minHeight="60" prefHeight="40" maxHeight="40"/>
                    <RowConstraints vgrow="ALWAYS" minHeight="60" prefHeight="40" maxHeight="40"/>
                    <RowConstraints vgrow="ALWAYS" minHeight="60" prefHeight="40" maxHeight="40"/>
                    <RowConstraints vgrow="ALWAYS" minHeight="60" prefHeight="40" maxHeight="40"/>
                    <RowConstraints vgrow="ALWAYS" minHeight="60" prefHeight="40" maxHeight="40"/>
                </rowConstraints>
            </GridPane>

            <!-- Légende améliorée avec les nouveaux états -->
            <HBox spacing="15" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <ImageView fitWidth="12" fitHeight="12" preserveRatio="true">
                        <Image url="@../../icons/accepte.png"/>
                    </ImageView>
                    <Label text="Acceptée" style="-fx-font-size: 12px; -fx-text-fill: #5a5c69;"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <ImageView fitWidth="12" fitHeight="12" preserveRatio="true">
                        <Image url="@../../icons/en-attente.png"/>
                    </ImageView>
                    <Label text="En attente" style="-fx-font-size: 12px; -fx-text-fill: #5a5c69;"/>
                </HBox>

            </HBox>
            <!-- Résumé statistique -->
            <VBox fx:id="statsBox" style="-fx-background-color: #f8f9fc; -fx-background-radius: 10; -fx-padding: 10; -fx-spacing: 5;">
                <Label text="Résumé du mois" style="-fx-font-weight: bold; -fx-text-fill: #1b1a1a;"/>
                <HBox spacing="15">
                    <VBox spacing="5">
                        <Label fx:id="totalLabel" text="Total: 0" style="-fx-text-fill: #5a5c69;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label fx:id="enAttenteLabel" text="En attente: 0" style="-fx-text-fill: #e8b73b;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label fx:id="accepteesLabel" text="Acceptée: 0" style="-fx-text-fill: #158d54;"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </StackPane>
</AnchorPane>