<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.OffreEmploi.AjouterOffreEmploiController"
            stylesheets="@/css/stylesOffresEmploi.css"
            prefHeight="600.0" prefWidth="800.0">
    <!-- Navbar positionnée en haut et prenant toute la largeur -->
    <fx:include fx:id="navbar" source="../navbarFront.fxml" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20"/>
    <!-- Conteneur principal centré -->
    <VBox spacing="20" alignment="CENTER"
          AnchorPane.topAnchor="30" AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <!-- Titre de la page -->
        <Label text="Ajouter une Offre d'Emploi" styleClass="form-title"/>

        <!-- Conteneur du formulaire -->
        <GridPane hgap="15" vgap="5" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints prefWidth="150" halignment="RIGHT"/>
                <ColumnConstraints prefWidth="300" halignment="LEFT"/>
                <ColumnConstraints prefWidth="150" halignment="RIGHT"/>
                <ColumnConstraints prefWidth="300" halignment="LEFT"/>
            </columnConstraints>

            <!-- Colonne gauche -->
            <!-- Ligne 0: Titre -->
            <Label text="📝 Titre de l'offre" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="titreField" styleClass="form-field" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Text fx:id="titreError" fill="RED" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <!-- Ligne 2: Description -->
            <Label text="≡ Description" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="descriptionField" styleClass="form-field" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Text fx:id="descriptionError" fill="RED" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <!-- Ligne 4: Nombre de postes -->
            <Label text="👥 Nombre de postes" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="nombrePostesField" styleClass="form-field" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Text fx:id="nombrePostesError" fill="RED" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <!-- Compétences - Ligne 6 -->
            <Label text="🛠 Compétences requises" styleClass="field-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <VBox GridPane.rowIndex="6" GridPane.columnIndex="1" spacing="5">
                <HBox spacing="5">
                    <TextField fx:id="competencesField" styleClass="form-field" promptText="Ajouter une compétence"/>
                    <Text fx:id="competencesError" fill="RED" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    <Button text="+" styleClass="small-button" onAction="#ajouterCompetence"/>
                </HBox>
                <ListView fx:id="competencesListView" styleClass="competences-list" prefHeight="100"/>
            </VBox>

            <!-- Colonne droite -->
            <!-- Ligne 0: Date début -->
            <Label text="📅 Date de début" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <DatePicker fx:id="dateDebutPicker" styleClass="form-field" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
            <Text fx:id="dateDebutError" fill="RED" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

            <!-- Ligne 2: Date fin -->
            <Label text="📆 Date de fin estimée" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
            <DatePicker fx:id="dateFinPicker" styleClass="form-field" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
            <Text fx:id="dateFinError" fill="RED" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

            <!-- Ligne 4: Localisation -->
            <Label text="🌍 Localisation" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
            <ComboBox fx:id="localisationComboBox" styleClass="form-field" GridPane.rowIndex="4" GridPane.columnIndex="3" promptText="Sélectionnez un gouvernorat"/>
            <Text fx:id="localisationError" fill="RED" GridPane.rowIndex="5" GridPane.columnIndex="3"/>

            <!-- Ligne 6: Salaire -->
            <Label text="💵 Salaire" styleClass="field-label" GridPane.rowIndex="6" GridPane.columnIndex="2"/>
            <TextField fx:id="salaireField" styleClass="form-field" GridPane.rowIndex="6" GridPane.columnIndex="3"/>
            <Text fx:id="salaireError" fill="RED" GridPane.rowIndex="7" GridPane.columnIndex="3"/>


        </GridPane>

        <!-- Boutons -->
        <HBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
            <Button text="Annuler" styleClass="cancel-button" onAction="#annulerAjout"/>
            <Button text="Ajouter" styleClass="add-button" onAction="#ajouterOffre"/>
        </HBox>
    </VBox>
</AnchorPane>