<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@/css/stylesOffresEmploi.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.OffreEmploi.CandidaturesOffreController">
    <!-- Navbar positionnée en haut et prenant toute la largeur -->
    <fx:include fx:id="navbar" source="../navbarFront.fxml" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20"/>
    <!-- Titre en haut -->
    <Label fx:id="titreOffreLabel" alignment="TOP_CENTER" contentDisplay="CENTER"
           layoutX="209.0" layoutY="21.0" prefHeight="18.0" prefWidth="326.0"
           styleClass="titre-offre" textAlignment="CENTER" textFill="#000000f3"
           textOverrun="CENTER_ELLIPSIS"
           AnchorPane.leftAnchor="700.0" AnchorPane.topAnchor="80.0">
        <font>
            <Font size="20.0" />
        </font>
    </Label>


    <!-- Contenu principal avec défilement -->
    <ScrollPane styleClass="main-scroll" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="150">
        <VBox fx:id="candidaturesContainer" spacing="15">
            <padding>
                <Insets bottom="20" left="20" right="20" top="10" />
            </padding>
        </VBox>
    </ScrollPane>
    <!-- Bouton Retour -->
    <Button fx:id="retourButton"
            style="-fx-background-color: transparent; -fx-text-fill: #858796; -fx-border-color: #d1d3e2; -fx-border-radius: 5; -fx-padding: 8 15; -fx-cursor: hand;"
            text="Retour à la liste"
            AnchorPane.leftAnchor="20.0"
            AnchorPane.bottomAnchor="10.0"
            onAction="#handleRetour">
        <graphic>
            <ImageView fitWidth="12" fitHeight="12" preserveRatio="true">
                <Image url="@../../icons/retour.png"/>
            </ImageView>
        </graphic>
    </Button>
</AnchorPane>
