<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Rectangle?>
<?import java.net.URL?>
<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.OffreEmploi.ListOffreEmploiAdminController" style="-fx-background-color: white;">
    <left>
        <fx:include source="../navbarBack.fxml" />
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;" alignment="TOP_CENTER">
            <!-- Barre supérieure -->
            <HBox spacing="10" alignment="TOP_CENTER" style="-fx-background-color: #ffffff; -fx-padding: 10 20 20 20; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;">
                <!-- Groupe recherche + bouton aligné à gauche -->
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <!-- Champ de recherche avec style transparent -->
                    <TextField  promptText="Rechercher..."
                                style="
                         -fx-pref-width: 400px;
                         -fx-background-radius: 20;
                         -fx-border-radius: 20;
                         -fx-padding: 8 15;
                         -fx-background-color: rgba(0,0,0,0.05);
                         -fx-prompt-text-fill: #a0a0a0;
                     "/>

                    <!-- Bouton recherche vert -->
                    <Button text="🔍"
                            style="
                       -fx-background-radius: 20;
                       -fx-padding: 8 15;
                       -fx-min-width: 40px;
                       -fx-background-color: #1cc88a;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                   "/>
                </HBox>

                <!-- Espace étirable pour repousser les autres éléments à droite -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Bouton notification style discret -->
                <Button  text="🔔"
                         style="
                           -fx-padding: 15 20;
                            -fx-min-width: 60px;
                            -fx-min-height: 60px;
                            -fx-background-color: transparent;
                            -fx-text-fill: #d1d3e2;
                            -fx-font-size: 18px;
                            -fx-cursor: hand;
                       "/>

                <!-- Bouton message style discret -->
                <Button text="📩"
                        style="
                            -fx-padding: 15 20;
                            -fx-min-width: 60px;
                            -fx-min-height: 60px;
                            -fx-background-color: transparent;
                            -fx-text-fill: #d1d3e2;
                            -fx-font-size: 24px;
                            -fx-cursor: hand;
                        "/>

                <!-- Séparateur avant le menu admin -->
                <Separator orientation="VERTICAL" style="-fx-padding: 0 10px;" />

                <!-- Menu admin avec texte gris -->
                <MenuButton style="-fx-background-color: transparent;" HBox.hgrow="NEVER">
                    <graphic>
                        <HBox spacing="5" alignment="CENTER">
                            <Label text="Admin" style="-fx-text-fill: #858796; -fx-font-size: 14px;" />
                            <ImageView fitHeight="28" fitWidth="28">
                                <Image url="@/img/admin.png"/>
                            </ImageView>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="Profil" />
                        <MenuItem text="Paramètres" />
                        <MenuItem text="Activité" />
                        <SeparatorMenuItem />
                        <MenuItem text="Déconnexion" />
                    </items>
                </MenuButton>
            </HBox>
            <!-- Entête avec titre et bouton stats -->
            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 0 0 20 0;">
                <VBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS">
                    <Label text="Gestion des offres d'emploi"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #858796;"/>
                    <Button onAction="#ouvrirFormulaireAjout" text="+ Ajouter une Offre"
                            style="-fx-background-color: #1cc88a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 5px;"/>
                </VBox>

            </HBox>

            <!-- Tableau avec marges -->
            <!-- Conteneur du tableau avec bord arrondi et ombre -->
            <StackPane style="-fx-background-color: white; -fx-background-radius: 10px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 2px;">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background-radius: 10px;">
                    <TableView fx:id="offresTable" prefWidth="900" style="-fx-background-color: transparent; -fx-background-radius: 10px; -fx-font-size: 14px; -fx-table-cell-border-color: transparent;">
                        <columns>
                            <TableColumn text="Titre" prefWidth="180" style="-fx-alignment: CENTER_LEFT;">
                                <cellValueFactory><PropertyValueFactory property="titre"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Localisation" prefWidth="120" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="localisation"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="statutCol" text="Statut" prefWidth="100" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Début" prefWidth="100" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="dateDebut"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Fin" prefWidth="100" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="DateFinEstimee"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Compétences" prefWidth="150" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="competencesRequises"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Salaire" prefWidth="80" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="salaire"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Postes" prefWidth="60" style="-fx-alignment: CENTER;">
                                <cellValueFactory><PropertyValueFactory property="nombrePostes"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="actionsCol" text="Actions" prefWidth="150" style="-fx-alignment: CENTER;" />
                        </columns>

                        <!-- Style amélioré pour le tableau -->
                        <style>
                            <![CDATA[
                            .table-view {
                                -fx-background-radius: 10px;
                                -fx-border-radius: 10px;
                            }
                            .table-view .column-header-background {
                                -fx-background-color: #4e73df;
                                -fx-background-radius: 10px 10px 0 0;
                                -fx-padding: 0 0 5px 0;
                            }
                            .table-view .column-header {
                                -fx-background-color: transparent;
                                -fx-text-fill: white;
                                -fx-font-weight: bold;
                            }
                            .table-view .table-cell {
                                -fx-padding: 8 5;
                                -fx-border-color: transparent;
                            }
                            .table-row-cell {
                                -fx-cell-size: 45px;
                                -fx-border-color: transparent;
                            }
                            .table-row-cell:odd {
                                -fx-background-color: #f8f9fa;
                            }
                            .table-row-cell:even {
                                -fx-background-color: white;
                            }
                            .table-row-cell:selected {
                                -fx-background-color: #e0f7fa;
                                -fx-text-fill: #2e59a9;
                            }
                            .scroll-bar:horizontal, .scroll-bar:vertical {
                                -fx-background-color: transparent;
                            }
                            .scroll-bar .thumb {
                                -fx-background-color: #d1d3e2;
                                -fx-background-radius: 5px;
                            }
                            ]]>
                        </style>
                    </TableView>
                </ScrollPane>

                <!-- Masque pour les coins arrondis -->
                <Rectangle arcWidth="10" arcHeight="10" fill="transparent" stroke="transparent"/>
            </StackPane>
        </VBox>
    </center>

    <!-- Style pour les boutons au survol -->
    <stylesheets>
        <URL value="@../../css/stylesOffresEmploi.css"/>
    </stylesheets>
</BorderPane>