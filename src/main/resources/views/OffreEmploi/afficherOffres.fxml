<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.text.Text?>
<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@/css/stylesOffresEmploi.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.OffreEmploi.ListOffreEmploiController">
    <!-- Navbar positionnée en haut et prenant toute la largeur -->
    <fx:include fx:id="navbar" source="../navbarFront.fxml" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20"/>
     <!-- Conteneur principal vertical -->
    <VBox spacing="10" AnchorPane.leftAnchor="180" AnchorPane.rightAnchor="40" AnchorPane.topAnchor="100">
        <!-- Première ligne : Titre et bouton Ajouter -->
        <HBox alignment="CENTER_LEFT" spacing="20" AnchorPane.topAnchor="50">
            <!-- Titre -->
            <Label styleClass="main-title" text="Les offres d'emploi" />

            <!-- Élément flexible pour pousser le bouton à droite -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Bouton Ajouter complètement à droite -->
            <Button fx:id="ajouterBtn" onAction="#ouvrirFormulaireAjout" styleClass="add-button" text="Ajouter une offre" />
        </HBox>

        <!-- Deuxième ligne : Barre de recherche avec loupe -->
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="search-container"  >

            <ImageView fitHeight="20" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@/icons/search-icon.png" />
            </ImageView>
            <TextField fx:id="searchField" promptText="Rechercher une offre par titre..." styleClass="search-field"> </TextField>
        </HBox>
    </VBox>

    <!-- Contenu principal avec défilement -->
    <ScrollPane fx:id="mainScroll" styleClass="main-scroll" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="200.0">
        <TilePane fx:id="offreTilePane" alignment="TOP_LEFT" hgap="30" prefColumns="3" prefTileHeight="280" prefTileWidth="380" styleClass="tile-pane" vgap="30">
            <padding>
                <Insets bottom="30" left="30" right="30" top="20" />
            </padding>
        </TilePane>
    </ScrollPane>
</AnchorPane>
