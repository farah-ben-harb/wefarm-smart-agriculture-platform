<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.animation.FadeTransition?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.OffreEmploi.StatistiquesOffresController"
            style="-fx-background-color: #f8f9fa;"
            prefHeight="600.0" prefWidth="1000.0" fx:id="mainContainer">

    <left>
        <fx:include source="../navbarBack.fxml" />
    </left>

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-padding: 5 10; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;">
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <TextField  promptText="Rechercher..."
                                style=" -fx-pref-width: 400px; -fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 8 15; -fx-background-color: rgba(0,0,0,0.05); -fx-prompt-text-fill: #a0a0a0;"/>
                    <Button text="🔍"
                            style="-fx-background-radius: 20; -fx-padding: 8 15; -fx-min-width: 40px; -fx-background-color: #1cc88a; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button  text="🔔"
                         style="-fx-padding: 15 20; -fx-min-width: 60px; -fx-min-height: 60px; -fx-background-color: transparent; -fx-text-fill: #d1d3e2; -fx-font-size: 18px; -fx-cursor: hand;"/>
                <Button text="📩"
                        style="-fx-padding: 15 20; -fx-min-width: 60px; -fx-min-height: 60px; -fx-background-color: transparent; -fx-text-fill: #d1d3e2; -fx-font-size: 24px; -fx-cursor: hand;"/>
                <Separator orientation="VERTICAL" style="-fx-padding: 0 10px;" />
                <MenuButton style="-fx-background-color: transparent;" HBox.hgrow="NEVER">
                    <graphic>
                        <HBox spacing="5" alignment="CENTER">
                            <Label text="Admin" style="-fx-text-fill: #858796; -fx-font-size: 14px;" />
                            <ImageView fitHeight="28" fitWidth="28">
                                <Image url="@/img/admin.png"/>
                            </ImageView>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="Profil" />
                        <MenuItem text="Paramètres" />
                        <MenuItem text="Activité" />
                        <SeparatorMenuItem />
                        <MenuItem text="Déconnexion" />
                    </items>
                </MenuButton>
            </HBox>

            <HBox alignment="CENTER" spacing="10">
                <ImageView fitWidth="40" fitHeight="40" preserveRatio="true">
                    <image>
                        <Image url="@/icons/stats_icon.png"/>
                    </image>
                </ImageView>
                <Label text="Statistiques des offres d'emploi"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;"/>
            </HBox>

            <Label text="Analyse par saisons et gouvernorats"
                   style="-fx-font-size: 18px; -fx-text-fill: #2d6a4f;"/>

            <HBox alignment="CENTER" spacing="40">
                <VBox alignment="CENTER" spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <BarChart fx:id="saisonChart" title="Répartition par saison"
                              legendVisible="false" animated="false"
                              style="-fx-font-size: 14px;" prefWidth="600" prefHeight="400">
                        <xAxis>
                            <CategoryAxis label="Saisons">
                                <tickLabelFont>
                                    <Font size="14"/>
                                </tickLabelFont>
                            </CategoryAxis>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Pourcentage (%)" lowerBound="0" upperBound="100">
                                <tickLabelFont>
                                    <Font size="12"/>
                                </tickLabelFont>
                            </NumberAxis>
                        </yAxis>
                        <effect>
                            <Glow level="0.3"/>
                        </effect>
                    </BarChart>

                    <Label text="Distribution des offres selon les saisons"
                           style="-fx-font-size: 16px; -fx-text-fill: #555;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <PieChart fx:id="gouvernoratChart" title="Répartition géographique"
                              legendVisible="true" animated="true"
                              style="-fx-font-size: 14px;" prefWidth="400" prefHeight="400">
                    </PieChart>
                    <Label text="Distribution par gouvernorat (24 régions)"
                           style="-fx-font-size: 16px; -fx-text-fill: #555;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <fx:define>
        <FadeTransition fx:id="fadeIn" duration="1000ms" fromValue="0.0" toValue="1.0"/>
    </fx:define>
</BorderPane>
